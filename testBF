local BountyHunterEngine = {
    CurrentMode = "OFF", -- OFF, Passive Hunter, Active Hunter, Ruthless Hunter, Smart Hunter, VIP Hunter
    TargetMemory = {}, -- [UserId] = { Kills = 0, DeathsAgainst = 0, Danger = "LOW", BlacklistedUntil = 0, LastPos = Vector3.zero, LastMoved = os.clock() }
