function StateReader:ResolveMark(s)
    for _, id in ipairs(MARK_ORDER) do
        local m = MARKS[id]
        if not m.verify(s) then
            local isGateReady = m.gate(s)
            return id, isGateReady, m.stage, m.name
        end
    end
    return "M16_DONE", true, "DONE", "All Progression Completed"
end

function StateReader:RouteStage(s)
    local markId, isGateReady, stage, markName = self:ResolveMark(s)
    return stage, markId, isGateReady, markName
end

