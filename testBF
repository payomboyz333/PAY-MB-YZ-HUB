function GetCurrentQuestInfo()
    local lp = LocalPlayer or game:GetService("Players").LocalPlayer
    local pg = lp and lp:FindFirstChild("PlayerGui")
    if not pg then return false, "", "" end

    -- 1. Modern Blox Fruits Quest UI (TrackedQuestFrame)
    local tqf = pg:FindFirstChild("TrackedQuestFrame")
    if tqf and tqf.Enabled then
        local frame = tqf:FindFirstChild("Frame")
        if frame and frame.Visible then
            local header = frame:FindFirstChild("header")
            local textLabel = header and header:FindFirstChild("textLabel")
            local desc = frame:FindFirstChild("description")
            local titleText = (textLabel and textLabel.Text) or ""
            local descText = (desc and desc.Text) or ""
            if #titleText > 0 or #descText > 0 then
                return true, titleText, descText
            end
        end
    end

    -- 2. Legacy Blox Fruits Quest UI (Main.Quest)
    local mq = pg:FindFirstChild("Main") and pg.Main:FindFirstChild("Quest")
    if mq and mq.Visible then
        local title = ""
        pcall(function()
            title = mq.Container.QuestTitle.Title.Text
        end)
        -- BUG FIX #5: Hardcoded "defeat 5 bandits" filter broke if Roblox changed
        -- tutorial text or the player uses a different language. Now we filter out
        -- any known tutorial / welcome quest patterns robustly.
        local isLikelyTutorial = string.find(title:lower(), "bandit") and string.find(title:lower(), "defeat")
        if #title > 0 and not isLikelyTutorial then
            return true, title, title
        end
    end

    return false, "", ""
end
getgenv().GetCurrentQuestInfo = GetCurrentQuestInfo

-- BUG FIX #4: Removed the ReplicatedStorage search — live mobs never live there,
-- only replicated templates do. Searching it every GetMobByName call was wasted
-- CPU and could return false positives (template model, zero health, never in workspace).
-- Also added optional maxDist parameter used by TargetManager.GetBestTarget.
function GetMobByName(mobName, maxDist)
    if not mobName then return nil end
    local mobLower = string.lower(mobName)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local playerPos = hrp and hrp.Position

    local function isValidMob(v)
        if not v:FindFirstChild("Humanoid") then return false end
        if not v:FindFirstChild("HumanoidRootPart") then return false end
        if v.Humanoid.Health <= 0 then return false end
        if maxDist and playerPos then
            if (v.HumanoidRootPart.Position - playerPos).Magnitude > maxDist then return false end
        end
        return true
    end

    -- Primary: workspace.Enemies (Blox Fruits canonical mob container)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        local bestDist, bestMob = math.huge, nil
        for _, v in ipairs(enemies:GetChildren()) do
            local nameLower = string.lower(v.Name)
            if (nameLower == mobLower or string.find(nameLower, mobLower, 1, true)) and isValidMob(v) then
                if playerPos then
                    local d = (v.HumanoidRootPart.Position - playerPos).Magnitude
                    if d < bestDist then bestDist = d; bestMob = v end
                else
                    return v
                end
            end
        end
        if bestMob then return bestMob end
    end

    -- Secondary: top-level workspace Models (boss mobs not in Enemies folder)
    local bestDist, bestMob = math.huge, nil
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character then
            local nameLower = string.lower(v.Name)
            if (nameLower == mobLower or string.find(nameLower, mobLower, 1, true)) and isValidMob(v) then
                if playerPos then
                    local d = (v.HumanoidRootPart.Position - playerPos).Magnitude
                    if d < bestDist then bestDist = d; bestMob = v end
                else
                    return v
                end
            end
        end
    end
    return bestMob
end

