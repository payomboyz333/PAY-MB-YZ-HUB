-- BUG FIX #1: MovementManager fallback was a raw CFrame teleport (instant pos set).
-- On mobile the server rejects instant position changes and rubberband the player back.
-- Safe fallback: step-teleport with yield between steps to simulate movement + give
-- the server time to accept each new position before the next one is sent.
MovementManager = getgenv().MovementManager or (function()
    local function safeTeleport(self, targetCF, speed, priority)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local startPos = hrp.Position
        local endPos   = targetCF.Position
        local dist     = (endPos - startPos).Magnitude
        -- Clamp steps: minimum 1, max 30. One step per ~20 studs for smoothness.
        local steps    = math.clamp(math.ceil(dist / 20), 1, 30)
        local stepWait = math.clamp(1 / (speed or 150), 0.02, 0.15)
        for i = 1, steps do
            if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then break end
            local alpha = i / steps
            local lerpPos = startPos:Lerp(endPos, alpha)
            -- Preserve target orientation on final step, neutral on intermediate
            local stepCF  = (i == steps) and targetCF or CFrame.new(lerpPos)
            LocalPlayer.Character.HumanoidRootPart.CFrame = stepCF
            task.wait(stepWait)
        end
    end
    return { MoveTo = safeTeleport, Stop = function() end }
end)()
