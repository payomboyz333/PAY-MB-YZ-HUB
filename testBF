local DynamicQuestListCache = nil
local function BuildDynamicQuestList()
    if DynamicQuestListCache then return DynamicQuestListCache end
    local list = {}
    local rawQuests = nil
    pcall(function() rawQuests = require(ReplicatedStorage:WaitForChild("Quests")) end)
    if type(rawQuests) == "table" then
        local blacklist = { "MarineQuest", "BartiloQuest", "CitizenQuest", "Trainees" }
        for qGroup, qData in pairs(rawQuests) do
            if type(qData) == "table" and not table.find(blacklist, qGroup) then
                for qIdx, qInfo in ipairs(qData) do
                    if type(qInfo) == "table" and qInfo.LevelReq and type(qInfo.Task) == "table" then
                        local totalCount = 0
                        for _, count in pairs(qInfo.Task) do
                            if type(count) == "number" then totalCount = totalCount + count end
                        end
                        if totalCount > 1 then
                            table.insert(list, {
                                Group = qGroup,
                                Index = qIdx,
                                LevelReq = qInfo.LevelReq,
                                Task = qInfo.Task,
                                DisplayName = qInfo.Name
                            })
                        end
                    end
                end
            end
        end
        table.sort(list, function(a, b) return a.LevelReq < b.LevelReq end)
        DynamicQuestListCache = list
    end
    return list
end

local function GetQuestNPCCFrame(npcName)
    for _, c in ipairs(workspace.NPCs:GetChildren()) do
        if c.Name == npcName and c:FindFirstChild("HumanoidRootPart") then
            return c.HumanoidRootPart.CFrame
        end
    end
    if ReplicatedStorage:FindFirstChild("NPCs") then
        for _, c in ipairs(ReplicatedStorage.NPCs:GetChildren()) do
            if c.Name == npcName and c:FindFirstChild("HumanoidRootPart") then
                return c.HumanoidRootPart.CFrame
            end
        end
    end
    return nil
end

function CheckQuest()
    local WS = getgenv().WorldState or WorldState
    local W1 = (getgenv().World1 ~= nil) and getgenv().World1 or World1
    local W2 = (getgenv().World2 ~= nil) and getgenv().World2 or World2
    local curSea = W1 and 1 or (W2 and 2 or 3)
    
    local Level = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")) and LocalPlayer.Data.Level.Value or 1

    -- Try dynamic engine first
    local dynList = BuildDynamicQuestList()
    if dynList and #dynList > 0 then
        local selectedQuest = dynList[1]
        for i = #dynList, 1, -1 do
            if Level >= dynList[i].LevelReq then
                selectedQuest = dynList[i]
                break
            end
        end

        -- Cap highest quest per Sea to prevent taking Sea 3 quest while in Sea 2
        if curSea == 1 and Level >= 700 then
            for _, q in ipairs(dynList) do
                if q.Group == "FountainQuest" and q.Index == 2 then selectedQuest = q break end
            end
        elseif curSea == 2 and Level >= 1500 then
            for _, q in ipairs(dynList) do
                if q.Group == "ForgottenQuest" and q.Index == 2 then selectedQuest = q break end
            end
        end

        -- BUG FIX #4: next() returns a non-deterministic key from the Task table.
        -- This caused a different mob to be targeted randomly between invocations.
        -- Use deterministic selection: pick the mob with the highest kill count requirement.
        local mName = nil
        local highestCount = -1
        for k, v in pairs(selectedQuest.Task) do
            local count = type(v) == "number" and v or 0
            if count > highestCount then
                highestCount = count
                mName = k
            end
        end
        if not mName then mName = next(selectedQuest.Task) end -- absolute fallback
        Monster = mName
        NameQuest = selectedQuest.Group
        LevelQuest = selectedQuest.Index
        NameCheckQuest = selectedQuest.DisplayName or mName

        -- Lookup NPC position
        local npcCF = nil
        pcall(function()
            local guide = require(ReplicatedStorage:WaitForChild("GuideModule"))
            if guide and guide.Data and guide.Data.LastClosestNPC then
                npcCF = GetQuestNPCCFrame(guide.Data.LastClosestNPC)
            end
        end)

        -- Static fallback coordinates if NPC or Mob CFrame is not found
        local staticTable = (curSea == 1 and Sea1_Quests) or (curSea == 2 and Sea2_Quests) or Sea3_Quests
        local fallbackItem = nil
        for _, item in ipairs(staticTable) do
            if item[3] == NameQuest and item[4] == LevelQuest then
                fallbackItem = item
                break
            end
        end

        if npcCF then
            CFrameQ = npcCF
        elseif fallbackItem then
            CFrameQ = CFrame.new(fallbackItem[6], fallbackItem[7], fallbackItem[8])
        else
            CFrameQ = CFrame.new(0, 50, 0)
        end

        if MobCFrames[Monster] then
            CFrameMon = MobCFrames[Monster]
        elseif fallbackItem then
            CFrameMon = CFrame.new(fallbackItem[9], fallbackItem[10], fallbackItem[11])
        else
            CFrameMon = CFrameQ
        end

        getgenv().Monster = Monster
        getgenv().NameQuest = NameQuest
        getgenv().LevelQuest = LevelQuest
        getgenv().NameCheckQuest = NameCheckQuest
        getgenv().CFrameQ = CFrameQ
        getgenv().CFrameMon = CFrameMon
        return
    end

    -- Complete Fallback: Inline Static Quest Tables
    local questList = (curSea == 1 and Sea1_Quests) or (curSea == 2 and Sea2_Quests) or Sea3_Quests
    for _, item in ipairs(questList) do
        if Level <= item[1] then
            Monster = item[2]
            NameQuest = item[3]
            LevelQuest = item[4]
            NameCheckQuest = item[5]
            CFrameQ = CFrame.new(item[6], item[7], item[8])
            CFrameMon = CFrame.new(item[9], item[10], item[11])

            getgenv().Monster = Monster
            getgenv().NameQuest = NameQuest
            getgenv().LevelQuest = LevelQuest
            getgenv().NameCheckQuest = NameCheckQuest
            getgenv().CFrameQ = CFrameQ
            getgenv().CFrameMon = CFrameMon
            return
        end
    end
end

function GetNearestMob(originMob, maxDistance)
    if not originMob or not originMob:FindFirstChild("HumanoidRootPart") then return nil end
    local nearest = nil
    local nearestDistance = math.huge
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= originMob
        and mob.Name == originMob.Name
        and mob.Parent
        and mob:FindFirstChild("Humanoid")
        and mob:FindFirstChild("HumanoidRootPart")
        and mob.Humanoid.Health > 0 then
            local dist = (mob.HumanoidRootPart.Position - originMob.HumanoidRootPart.Position).Magnitude
            if dist <= maxDistance and dist < nearestDistance then
                nearest = mob
                nearestDistance = dist
            end
        end
    end
    return nearest
end

