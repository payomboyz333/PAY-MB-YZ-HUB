function SmartMoveAndAttack(mainMob, QuestTitle, Quest, IsCheckQuest, CustomName)
    if IsCheckQuest == nil then IsCheckQuest = true end
    CustomName = CustomName or NameCheckQuest

    if not mainMob or not mainMob.Parent or not mainMob:FindFirstChild("Humanoid") or not mainMob:FindFirstChild("HumanoidRootPart") then
        return false
    end

    -- BUG FIX #1: sethiddenproperty was called every task.wait() inside the loop.
    -- On mobile this caused constant desync with the server simulation boundary.
    -- Call once before the loop instead.
    pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)

    local humanoid = mainMob.Humanoid
    local hrp = mainMob.HumanoidRootPart
    humanoid.JumpPower = 0
    humanoid.WalkSpeed = 0
    hrp.CanCollide = false

    -- BUG FIX #3: BringMob BodyVelocity was created but set to Vector3.zero every tick —
    -- dead code that added physics noise. Replaced with actual pull-toward-player logic.
    local secondMob = nil
    local attackStartTime = os.clock()

    repeat
        -- BUG FIX #2: task.wait() with no argument = RunService.Heartbeat, spinning
        -- at 60+ Hz on desktop and creating CPU spikes on mobile. Minimum 0.05s throttle.
        task.wait(0.05)
        if not mainMob or not mainMob.Parent or not hrp or humanoid.Health <= 0 then break end
        if os.clock() - attackStartTime > 25 then break end -- Watchdog: prevent eternal freeze if mob is unreachable

        -- Quest Desync Verification: If current quest is wrong, abandon to avoid getting stuck
        local hasActiveQ, curQTitle, curQDesc = GetCurrentQuestInfo()
        if IsCheckQuest and hasActiveQ then
            local fullQText = (curQTitle .. " " .. curQDesc):lower()
            local expectedText = tostring(CustomName or Monster or ""):lower()
            if #expectedText > 0 and not string.find(fullQText, expectedText, 1, true) and not string.find(fullQText, "swan") and not string.find(fullQText, "bartilo") then
                pcall(function() CommF_:InvokeServer("AbandonQuest") end)
                task.wait(0.3)
                break
            end
        end

        if IsCheckQuest then CheckQuest() end

        local playerHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not playerHrp then break end
        local dist = (hrp.Position - playerHrp.Position).Magnitude

        -- Live combat status on title HUD
        if title then
            title.Text = string.format("⚔️ Farming %s (%d/%d HP)", tostring(mainMob.Name), math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
        end

        -- Hover 12 studs above mob (Optimal Melee Reach) - Priority 4 outranks idle movement (Priority 2)
        local hoverCF = hrp.CFrame * CFrame.new(0, 12, 0)
        if MovementManager and MovementManager.MoveTo then
            MovementManager:MoveTo(hoverCF, 350, 4)
        end

        -- BringMob: pull nearest same-name mob to same position (pack farming)
        if getgenv().Configs and getgenv().Configs.BringMob then
            secondMob = GetNearestMob(mainMob, 350)
            if secondMob and secondMob:FindFirstChild("HumanoidRootPart") then
                secondMob.HumanoidRootPart.CFrame = hrp.CFrame
                secondMob.HumanoidRootPart.CanCollide = false
            end
        end

        -- Attack Execution
        if dist <= 35 then
            if EquipWeapon then
                EquipWeapon(getgenv().Configs and getgenv().Configs.SelectWeapon or "Melee")
            end
            if Attack then
                if secondMob then
                    Attack({mainMob, secondMob})
                else
                    Attack(mainMob)
                end
            end
        end
    until not mainMob
        or not mainMob.Parent
        or not mainMob:FindFirstChild("Humanoid")
        or (mainMob.Humanoid.Health <= 0)
        or not (getgenv().Configs and getgenv().Configs.AutoFarmLevel)

    return humanoid.Health <= 0
end

