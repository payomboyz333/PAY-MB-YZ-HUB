function TargetManager:GetBestTarget(mobName, searchRadius)
    searchRadius = searchRadius or 600
    WorldState:Update()
    if not WorldState.HRP or not mobName then return nil end

    local bestMob = nil
    local maxScore = -99999
    local mobLower = string.lower(mobName)

    local function evaluateCandidate(v)
        if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local nameLower = string.lower(v.Name)
            if nameLower == mobLower or string.find(nameLower, mobLower, 1, true) then
                local dist = (v.HumanoidRootPart.Position - WorldState.HRP.Position).Magnitude
                if dist <= searchRadius then
                    local score = 1000 - dist
                    if v.Humanoid.Health < v.Humanoid.MaxHealth then score = score + 200 end
                    if score > maxScore then
                        maxScore = score
                        bestMob = v
                    end
                end
            end
        end
    end

    if workspace:FindFirstChild("Enemies") then
        for _, v in ipairs(workspace.Enemies:GetChildren()) do
            evaluateCandidate(v)
        end
    end

    if not bestMob then
        for _, v in ipairs(workspace:GetChildren()) do
            if v:IsA("Model") and v ~= LocalPlayer.Character then
                evaluateCandidate(v)
            end
        end
    end

    self.CurrentTarget = bestMob
    self.TargetScore = maxScore
    return bestMob
end

function TargetManager:IsBossSpawned(bossName)
    if not bossName or type(bossName) ~= "string" then return nil end
    local bossLower = string.lower(bossName)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        local direct = enemies:FindFirstChild(bossName)
        if direct and direct:FindFirstChild("Humanoid") and direct.Humanoid.Health > 0 and direct:FindFirstChild("HumanoidRootPart") then
            return direct
        end
        for _, v in ipairs(enemies:GetChildren()) do
            if string.find(string.lower(v.Name), bossLower, 1, true) then
                local h = v:FindFirstChild("Humanoid")
                if h and h.Health > 0 and v:FindFirstChild("HumanoidRootPart") then return v end
            end
        end
    end
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character and string.find(string.lower(v.Name), bossLower, 1, true) then
            local h = v:FindFirstChild("Humanoid")
            if h and h.Health > 0 and v:FindFirstChild("HumanoidRootPart") then return v end
        end
    end
    return nil
end
getgenv().IsBossSpawned = function(bossName) return TargetManager:IsBossSpawned(bossName) end

