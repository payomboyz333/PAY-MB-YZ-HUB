function BountyHunterEngine:ScanServerTargets()
    if self.CurrentMode == "OFF" or self.CurrentMode == "DISABLED" then
        return nil, 0
    end

    local bestTarget = nil
    local maxScore = -9999
    local totalServerScore = 0

    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myLvl = (LP:FindFirstChild("Data") and LP.Data:FindFirstChild("Level")) and LP.Data.Level.Value or 1

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Team ~= LP.Team and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local userId = p.UserId
            local mem = self.TargetMemory[userId] or { Kills = 0, DeathsAgainst = 0, Danger = "LOW", BlacklistedUntil = 0 }

            -- Check blacklist
            if os.clock() < mem.BlacklistedUntil then
                continue
            end

            local pData = p:FindFirstChild("Data")
            local bounty = (pData and pData:FindFirstChild("Bounty")) and pData.Bounty.Value or 2500000
            local pLvl = (pData and pData:FindFirstChild("Level")) and pData.Level.Value or 1500
            local pRoot = p.Character.HumanoidRootPart
            local dist = myRoot and (myRoot.Position - pRoot.Position).Magnitude or 5000

            -- Calculate Target Score
            local score = 0
            score = score + math.floor(bounty / 50000) -- Bounty Reward

            if pLvl <= myLvl + 100 then score = score + 100 end -- Easy Kill
            if mem.Danger == "LOW" then score = score + 50 end -- Low Danger
            score = score + math.max(0, 100 - math.floor(dist / 50)) -- Near Position

            -- Check AFK status
            if mem.LastPos and (mem.LastPos - pRoot.Position).Magnitude < 2 and (os.clock() - (mem.LastMoved or os.clock())) > 10 then
                score = score + 150 -- AFK Target Bonus!
            end
            mem.LastPos = pRoot.Position
            mem.LastMoved = os.clock()
            self.TargetMemory[userId] = mem

            if self.CurrentMode == "VIP Hunter" and bounty < 5000000 then
                score = score - 300
            end

            totalServerScore = totalServerScore + math.max(0, score)

            if score > maxScore then
                maxScore = score
                bestTarget = { Player = p, Score = score, Bounty = bounty, Distance = dist }
            end
        end
    end

    return bestTarget, totalServerScore
end

function BountyHunterEngine:CheckRetreat(targetPlayer, playerHpPct)
    if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("Humanoid") then return false end
    local targetHpPct = (targetPlayer.Character.Humanoid.Health / math.max(1, targetPlayer.Character.Humanoid.MaxHealth)) * 100

    if playerHpPct < 30 and targetHpPct > 70 then
        local userId = targetPlayer.UserId
        if not self.TargetMemory[userId] then self.TargetMemory[userId] = { Kills = 0, DeathsAgainst = 0, Danger = "HIGH", BlacklistedUntil = 0 } end
        self.TargetMemory[userId].DeathsAgainst = self.TargetMemory[userId].DeathsAgainst + 1
        self.TargetMemory[userId].Danger = "HIGH"
        self.TargetMemory[userId].BlacklistedUntil = os.clock() + 1200 -- 20 mins Blacklist
        warn("[BountyHunterEngine]: 🚨 RETREAT TRIGGERED! Blacklisted target " .. targetPlayer.Name .. " for 20 mins.")
        return true
    end
    return false
end

