        local nextPos = startPos:Lerp(targetPos, alpha)
        hum:MoveTo(nextPos)
        SpoofPosition()
        task.wait(0.08)
    end

    hum:MoveTo(targetPos)
    SpoofPosition()
    task.wait(0.5)
    return true
