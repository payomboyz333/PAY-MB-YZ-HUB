-- ⚡ 2. Zero Idle Engine (State Uptime & Downtime Tracker)
local ZeroIdleEngine = {
    CurrentState = "FIGHTING", -- FIGHTING, MOVING, WAITING, STUCK, LOADING, RECOVERING
    TimeInState = {
        FIGHTING = 0,
        MOVING = 0,
        WAITING = 0,
        STUCK = 0,
        LOADING = 0,
        RECOVERING = 0
    },
    LastStateChange = os.clock()
}

function ZeroIdleEngine:SetState(newState)
    local now = os.clock()
    local delta = now - self.LastStateChange
    if self.TimeInState[self.CurrentState] then
        self.TimeInState[self.CurrentState] = self.TimeInState[self.CurrentState] + delta
    end
    self.CurrentState = newState
    self.LastStateChange = now
end

function ZeroIdleEngine:GetMetrics()
    local now = os.clock()
    local delta = now - self.LastStateChange
    if self.TimeInState[self.CurrentState] then
        self.TimeInState[self.CurrentState] = self.TimeInState[self.CurrentState] + delta
    end
    self.LastStateChange = now

    local total = 0
    for _, t in pairs(self.TimeInState) do total = total + t end
    total = math.max(0.001, total)

    local activePct = ((self.TimeInState.FIGHTING + self.TimeInState.MOVING) / total) * 100
    local idlePct = (self.TimeInState.WAITING / total) * 100
    local recoveryPct = ((self.TimeInState.STUCK + self.TimeInState.RECOVERING) / total) * 100

    return {
        ActivePct = string.format("%.1f", activePct),
        IdlePct = string.format("%.1f", idlePct),
        RecoveryPct = string.format("%.1f", recoveryPct)
    }
end

