local function FindFlower(color)
    local hrp = LP and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local hrpPos = hrp and hrp.Position or Vector3.zero

    local targetNames = {
        Red = { "Flower1", "Red Flower", "RedFlower" },
        Blue = { "Flower2", "Blue Flower", "BlueFlower" },
        Yellow = { "Flower3", "Yellow Flower", "YellowFlower" }
    }

    local searchList = targetNames[color] or { color .. "Flower" }
    local foundPos = nil
    local shortestDist = math.huge

    -- BUG FIX #14: workspace:GetDescendants() scans thousands of objects every call.
    -- On mobile this causes significant frame spikes. Replaced with targeted search:
    -- check known parent containers first (workspace.Map, workspace.Flowers, workspace)
    -- using FindFirstChild/GetChildren (1-2 levels max) instead of full traversal.
    local function searchContainer(container)
        if not container then return end
        for _, name in ipairs(searchList) do
            local obj = container:FindFirstChild(name, true)  -- recursive but name-indexed = fast
            if obj then
                local p = obj:IsA("BasePart") and obj.Position
                    or (obj:FindFirstChild("Handle") and obj.Handle.Position)
                    or (obj.PrimaryPart and obj.PrimaryPart.Position)
                if p then
                    local d = (hrpPos - p).Magnitude
                    if d < shortestDist then
                        shortestDist = d
                        foundPos = p
                    end
                end
            end
        end
    end

    -- Search targeted containers in priority order
    searchContainer(workspace:FindFirstChild("Map"))
    searchContainer(workspace:FindFirstChild("Flowers"))
    searchContainer(workspace:FindFirstChild("Islands"))
    -- Fallback: direct children of workspace only (not full descendants)
    if not foundPos then
        for _, child in ipairs(workspace:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Model") then
                for _, name in ipairs(searchList) do
                    local obj = child:FindFirstChild(name)
                    if obj then
                        local p = obj:IsA("BasePart") and obj.Position
                            or (obj.PrimaryPart and obj.PrimaryPart.Position)
                        if p then
                            local d = (hrpPos - p).Magnitude
                            if d < shortestDist then shortestDist = d; foundPos = p end
                        end
                    end
                end
            end
        end
    end

    if foundPos then return foundPos, true end

    local spawnSets = { Red = RED_FLOWER_POSITIONS, Blue = BLUE_FLOWER_POSITIONS }
    local list = spawnSets[color] or {}
    local bestPoint = nil
    local minDist = math.huge

    for _, spawnPos in ipairs(list) do
        local d = (hrpPos - spawnPos).Magnitude
        if d < minDist then
            minDist = d
            bestPoint = spawnPos
        end
    end

    return bestPoint or Vector3.new(1250, 40, -5100), false
end

local function FlowerPlan(state, bp, char)
    local hasYellow = (bp and bp:FindFirstChild("Flower 3")) or (char and char:FindFirstChild("Flower 3"))
    local hasRed = (bp and bp:FindFirstChild("Flower 1")) or (char and char:FindFirstChild("Flower 1"))
    local hasBlue = (bp and bp:FindFirstChild("Flower 2")) or (char and char:FindFirstChild("Flower 2"))

    if not hasYellow then
        return { task = "FARM_YELLOW", mob = "Swan Pirates", timeout = 1800 }
    end
    
    local lighting = game:GetService("Lighting")
    local clock = lighting and lighting.ClockTime or 12
    local isDay = clock >= 6 and clock <= 18
    local isNight = clock >= 18 or clock <= 5

    if isDay and not hasRed then
        local targetPos, isLive = FindFlower("Red")
        return { task = "COLLECT_RED", pos = targetPos, isLive = isLive }
    end
    if isNight and not hasBlue then
        local targetPos, isLive = FindFlower("Blue")
        return { task = "COLLECT_BLUE", pos = targetPos, isLive = isLive }
    end
    
    return { task = "SAFE_IDLE", pos = Vector3.new(1250, 40, -5100) }
end

local function TierBottleneck(tier, fragCount, awakenAccumSec)
    local tierCosts = { 1000, 1500, 2250, 3000, 3750, 4500, 5250, 5500 }
    local tierTimes = { 300, 600, 900, 1200, 1500, 1800, 2100, 2400 }

    local targetCost = tierCosts[tier] or 3000
    local targetTime = tierTimes[tier] or 1200

    local needTime = math.max(0, targetTime - awakenAccumSec)
    local needFrag = math.max(0, targetCost - fragCount)

    local etaTime = needTime / 0.4
    local etaFrag = (needFrag / 5000) * 3600

    if etaTime > etaFrag then
        return "TIME", "⚡ Focus Energy Mobs (Accelerate Awakening)"
    else
        return "FRAG", "💰 Focus Raids / Chips (Maximize Frag/hr)"
    end
end

-- 📊 4. Utility Scorer & Task Pool Engine
local function StageRelevance(tStage, currentStage)
    if tStage == currentStage then return 3.0 end
    if tStage == "PRE_PROVISION" then return 0.6 end
    return 0.0
end

local function CalculateGlobalUtilityScore(task, currentStage)
    local execCost = task.execTime or 60
    local travelCost = 5
    local switchCost = (Controller:Current() == task.id) and 0 or 15
    local riskCost = (task.risk or 0) * 2

    local denominator = execCost + travelCost + switchCost + riskCost
    local numerator = (task.value or 100) * (task.urgency or 5) * (task.pSuccess or 0.9) * (task.window or 1.0)
    
    local st = StageRelevance(task.stage, currentStage)
    numerator = numerator * st

    local ageBonus = (task.age or 0) * AGE_RATE
    return (numerator / math.max(1, denominator)) + ageBonus
end

