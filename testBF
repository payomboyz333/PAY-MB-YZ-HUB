-- 🛡️ PHYSICAL FRUIT VERIFICATION ENGINE (STRICT HANDLE & EXP CHECK)
-- Prevents mistaking active Devil Fruit movesets (e.g. Buddha-Buddha) for sacrificeable fruits!
local function IsPhysicalFruitTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    -- Real fruits dropped, stored, or rolled have a physical Handle BasePart
    if not tool:FindFirstChild("Handle") then return false end
    -- Active power movesets have Exp, Mastery, or AwakenedMoves folders
    if tool:FindFirstChild("Exp") or tool:FindFirstChild("AwakenedMoves") then return false end
    local tip = tool.ToolTip or ""
    local name = tool.Name or ""
    return tip == "Blox Fruit" or tip == "Demon Fruit" or string.find(name:lower(), "fruit") or string.find(name:lower(), "-")
end

local function Has1MFruitInInventoryOrBackpack()
    -- BUG FIX #6 / #10: string.split("-") is a Roblox API extension not available in all
    -- executor environments. Replaced with string.match() which is standard Lua.
    local function FruitBaseName(name)
        return string.match(name, "^([^%-]+)") or name
    end

    local containers = { LocalPlayer.Backpack, LocalPlayer.Character }
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if IsPhysicalFruitTool(item) then
                    for fName, _ in pairs(M1_Fruits) do
                        local baseName = FruitBaseName(fName):lower()
                        if string.find(item.Name:lower(), fName:lower(), 1, true)
                            or string.find(item.Name:lower(), baseName, 1, true) then
                            return item
                        end
                    end
                end
            end
        end
    end

    -- Check Stored Fruits in getInventoryFruits (NOT getInventory)
    local storedFruits = nil
    pcall(function() storedFruits = CommF_:InvokeServer("getInventoryFruits") end)
    if type(storedFruits) == "table" then
        local catalog = nil
        pcall(function() catalog = CommF_:InvokeServer("GetFruits") end)
        local priceMap = {}
        if type(catalog) == "table" then
            for _, entry in pairs(catalog) do
                if entry.Name and entry.Price then
                    priceMap[entry.Name] = entry.Price
                end
            end
        end

        for _, fData in pairs(storedFruits) do
            local fruitName = fData.Name or fData.Value or (type(fData) == "string" and fData)
            if fruitName then
                local price = priceMap[fruitName] or M1_Fruits[fruitName] or 0
                if price >= 1000000 then
                    pcall(function() CommF_:InvokeServer("F_", "LoadFruit", fruitName) end)
                    task.wait(0.5)
                    local loaded = LocalPlayer.Backpack:FindFirstChild(fruitName) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(fruitName))
                    if loaded and IsPhysicalFruitTool(loaded) then
                        return loaded
                    end
                end
            end
        end
    end
    return nil
end


