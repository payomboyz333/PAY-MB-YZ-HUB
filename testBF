    if logType == "success" or logType == "QUEST_OK" then prefix = "✅"
    elseif logType == "error" or logType == "FAIL" then prefix = "❌"
    elseif logType == "warn" or logType == "RECOVERY" then prefix = "⚠️"
    elseif logType == "P4" or logType == "FARM" then prefix = "⚔️"
    elseif logType == "P5" or logType == "MELEE" then prefix = "👊"
    elseif logType == "P1" or logType == "TRANSITION" then prefix = "🌊"
    elseif logType == "P0" or logType == "EMERGENCY" then prefix = "🛑"
    end

    local entry = {
        time = timestamp,
        category = category or "ENGINE",
        message = message,
        logType = logType or "info",
        fullText = string.format("[%s] [%s] %s %s", timestamp, category or "ENGINE", prefix, message)
    }

    table.insert(self.Logs, 1, entry)
    if #self.Logs > self.MaxLogs then
        table.remove(self.Logs, #self.Logs)
    end

    if self.OnLogAdded then
        pcall(self.OnLogAdded, entry)
    end
end

function KaitunMonitor:ClearLogs()
    self.Logs = {}
    if self.OnLogAdded then pcall(self.OnLogAdded, nil) end
end

function KaitunMonitor:UpdateUI()
    if self.UIUpdateCallback then
        pcall(self.UIUpdateCallback)
    end
end

