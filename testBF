    end

    -- BUG FIX #11: Previous logic reset the failure counter at >= 3 BEFORE
    -- checking >= 5, making the TeleportService escalation unreachable.
    -- Fix: check >= 5 first, then handle >= 3 (hard respawn).
    if count >= 5 then
        self.failureCounts[actionName] = 0
        local ts = game:GetService("TeleportService")
        pcall(function() ts:Teleport(game.PlaceId) end)
        return
    end

    if count >= 3 then
        self.failureCounts[actionName] = 0
        local hrp = LP and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = SafeRespawnCF() end
    end
end

