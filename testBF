                or string.format("📊 Level: %d/2800 (+%d) | ⚡ %s Lv/Hr | 💀 Deaths: %d", curLvl, KaitunMonitor.Stats.LevelsGained, speedStr, dCount)
        end
        if hGains then
            hGains.Text = isTH and string.format("💰 เงิน: +$%d | 💎 Frags: +%d | ⏱️ %s", KaitunMonitor.Stats.BeliGained, KaitunMonitor.Stats.FragsGained, runtimeStr)
                or string.format("💰 Beli: +$%d | 💎 Frags: +%d | ⏱️ %s", KaitunMonitor.Stats.BeliGained, KaitunMonitor.Stats.FragsGained, runtimeStr)
        end
    end)

    if kaitunStatusTextLabel then
        local zeroMetrics = (ZeroIdleEngine and ZeroIdleEngine.GetMetrics) and ZeroIdleEngine:GetMetrics() or {ActivePct = 99, IdlePct = 1, RecoveryPct = 0}
        local packSize = (DynamicMobPackEngine and DynamicMobPackEngine.EvaluatePackSize) and DynamicMobPackEngine:EvaluatePackSize(hpPct, 60) or 4
        local modeName = (AggressiveFarmMode and AggressiveFarmMode.CurrentMode) or "TURBO"

        kaitunStatusTextLabel.Text = string.format(
            isTH and "สถานะระบบ: %s | Sea %d | โหมด: 🔥 %s\nภารกิจปัจจุบัน: [%s] %s (ETA: %s)\n⚡ ZERO-IDLE UPTIME: Active %s%% | Idle %s%% | Recovery %s%%\n\n💖 ผู้เล่น: HP %s | Energy %s | อาวุธ: %s | ดึง Mob Pack: %d ตัว\n📊 ไก่ตัน: เลเวล %d / 2800 (+%d Lv) | ความเร็ว %s Lv/ชม.\n💀 สถิติ: ตาย %d ครั้ง | ฟื้นฟูระบบ %d ครั้ง\n💰 เงิน: +$%s | 💎 Frags: +%s | ⏱️ เวลา: %s"
            or "ENGINE STATUS: %s | World: Sea %d | Mode: 🔥 %s\nACTIVE OBJECTIVE: [%s] %s (ETA: %s)\n⚡ ZERO-IDLE UPTIME: Active %s%% | Idle %s%% | Recovery %s%%\n\n💖 METRICS: HP %s | Energy %s | Weapon: %s | Pack Size: %d mobs\n📊 COUNTER: Level %d / 2800 (+%d Lv) | Speed %s Lv/Hr\n💀 STATS: Deaths %d | Recovery %d\n💰 Beli: +$%s | Frags: +%s | Runtime: %s",
            KaitunMonitor.State.EngineStatus or "🟢 ACTIVE",
            seaNum,
            modeName,
            KaitunMonitor.State.PriorityTier or "P4",
            KaitunMonitor.State.ActiveObjective or (Monster or "LEVEL_FARM"),
            etaStr,
            zeroMetrics.ActivePct,
            zeroMetrics.IdlePct,
            zeroMetrics.RecoveryPct,
            hpStr,
            energyStr,
            curWeapon,
            packSize,
            curLvl,
            KaitunMonitor.Stats.LevelsGained,
            speedStr,
            dCount,
