local function RequestEntranceFastTravel(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local pPos = hrp.Position
    local tPos = (typeof(targetPos) == "CFrame" and targetPos.Position) or (typeof(targetPos) == "Vector3" and targetPos) or (targetPos and targetPos.Position)
    if not tPos then return false end

    local directDist = (pPos - tPos).Magnitude
    if directDist <= 2500 then return false end
    if LastEntranceTime and (os.clock() - LastEntranceTime < 2.5) then return false end

    local curWorld = (GetWorld and GetWorld()) or 1
    local portalList = FAST_TRAVEL_PORTALS[curWorld]
    if not portalList then return false end

    local bestPortal = nil
    local bestSaved = 0

    for name, portalPos in pairs(portalList) do
        local distFromPortalToTarget = (portalPos - tPos).Magnitude
        local distFromPlayerToPortal = (portalPos - pPos).Magnitude
        
        -- Only use portal if player is not already at that portal
        if distFromPlayerToPortal > 800 then
            local distanceSaved = directDist - distFromPortalToTarget
            if distanceSaved > 1500 and distanceSaved > bestSaved then
                bestSaved = distanceSaved
                bestPortal = portalPos
            end
        end
    end

    if bestPortal then
        LastEntranceTime = os.clock()
        pcall(function()
            local comm = CommF_ or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_"))
            if comm then
                comm:InvokeServer("requestEntrance", bestPortal)
                task.wait(0.25)
            end
        end)
        return true
    end
    return false
end
