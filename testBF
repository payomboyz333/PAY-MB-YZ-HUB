local function RefreshCombatRemote()
    pcall(function()
        r = nil
        local paths = {ReplicatedStorage:FindFirstChild("Util"), ReplicatedStorage:FindFirstChild("Remotes"), ReplicatedStorage:FindFirstChild("Assets"), ReplicatedStorage:FindFirstChild("Common"), ReplicatedStorage:FindFirstChild("FX")}
        for _, path in ipairs(paths) do
            if path then
                for _, child in ipairs(path:GetChildren()) do
                    if child:GetAttribute("Id") and child:IsA("RemoteEvent") then
                        r = child
                        break
                    end
                end
            end
            if r then break end
        end
        if ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net") and ReplicatedStorage.Modules.Net:FindFirstChild("seed") then
            seed = ReplicatedStorage.Modules.Net.seed:InvokeServer() * 2
        end
        LastSeedRefresh = tick()
        HitsSinceRefresh = 0
    end)
end

RefreshCombatRemote()

-- Background: auto-refresh combat remote + seed periodically
task.spawn(function()
    while scriptRunning do
        task.wait(SEED_REFRESH_INTERVAL)
        pcall(function()
            -- Refresh seed to prevent stale keys causing 0-damage hits
            if ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net") and ReplicatedStorage.Modules.Net:FindFirstChild("seed") then
                seed = ReplicatedStorage.Modules.Net.seed:InvokeServer() * 2
            end
            -- Re-scan dynamic remote in case it moved
            if not r or not r.Parent then
                RefreshCombatRemote()
            end
            LastSeedRefresh = tick()
            HitsSinceRefresh = 0
        end)
    end
end)

-- Skill V Auto-Cast helper (Black Leg / Death Step kick skill)
local function TryAutoSkillV()
    pcall(function()
        local skills = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Skills")
        if not skills then return end
        local meleeSkill = skills:FindFirstChild("Death Step") or skills:FindFirstChild("Black Leg")
        if not meleeSkill then return end
        local vSlot = meleeSkill:FindFirstChild("V")
        if not vSlot then return end
        local cd = vSlot:FindFirstChild("Cooldown")
        if cd and cd.AbsoluteSize.X <= 0.1 then
            local toolName = meleeSkill.Name
            local toolObj = IsOwn(toolName)
            local reqMas = (toolName == "Death Step") and 400 or 150
            if toolObj and toolObj:FindFirstChild("Level") and toolObj.Level.Value >= reqMas then
                VirtualInputManager:SendKeyEvent(true, "V", false, game)
                VirtualInputManager:SendKeyEvent(false, "V", false, game)
            end
        end
    end)
end

local function Attack(v)
    local isFast = (getgenv().Configs == nil or getgenv().Configs.FastAttack ~= false)
    local now = tick()
    local cooldown = isFast and ATTACK_COOLDOWN or 0.25
    if now - LastAttackTime < cooldown then return end
    LastAttackTime = now

    -- Activate tool animation + Buso
    pcall(function()
        local activeTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if activeTool and IsPhysicalFruit(activeTool) then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid:UnequipTools()
            end
            activeTool = nil
        end
        if not activeTool or not MatchesWeaponType(activeTool, getgenv().Configs and getgenv().Configs.SelectWeapon or "Melee") then
            activeTool = EquipWeapon(getgenv().Configs and getgenv().Configs.SelectWeapon or "Melee")
        end
        if activeTool and not IsPhysicalFruit(activeTool) then
            activeTool:Activate()
        end
        if LocalPlayer.Character and not LocalPlayer.Character:FindFirstChild("HasBuso") then
            CommF_:InvokeServer("Buso")
        end
    end)

    -- Auto-cast V skill
    TryAutoSkillV()

    -- Auto-cast skills (Z, X, C, V) especially for Blox Fruit and weapons
    AutoSkillUse(type(v) == "table" and v[1] or v)

    -- Refresh remote if stale or missing
    if not r or not r.Parent then
        RefreshCombatRemote()
    end
    -- Periodic seed refresh (damage watchdog: too many hits without refresh = stale key)
    HitsSinceRefresh = HitsSinceRefresh + 1
    if HitsSinceRefresh > 50 or (now - LastSeedRefresh > SEED_REFRESH_INTERVAL) then
        pcall(function()
            if ReplicatedStorage.Modules.Net:FindFirstChild("seed") then
                seed = ReplicatedStorage.Modules.Net.seed:InvokeServer() * 2
            end
        end)
        LastSeedRefresh = now
        HitsSinceRefresh = 0
    end
    if not r then return end

    -- Build encoded key & hit ID
    local h = "RE/RegisterHit"
    local serverTime = workspace:GetServerTimeNow()
    local key = math.floor(serverTime / 10 % 10)
    local encoded = ""
    for i = 1, #h do
        encoded = encoded .. string.char(bit32.bxor(string.byte(h, i), key + 1))
    end
    local hitId = bit32.bxor((r:GetAttribute("Id") or 0) + 909090, seed)
    local comboTag = tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(math.floor(serverTime % 10000))

    local function GetTargetHitPart(mob)
        if not mob then return nil end
        local partNames = {"Head", "HumanoidRootPart", "UpperTorso", "Torso", "RightUpperArm", "LeftUpperArm", "RightHand", "LeftHand"}
        for _, pName in ipairs(partNames) do
            local p = mob:FindFirstChild(pName)
            if p and p:IsA("BasePart") then return p end
        end
        return mob.PrimaryPart
    end

    local hitList = {}
    local primaryPart = nil

    if type(v) == "table" then
        for _, mob in ipairs(v) do
            local part = GetTargetHitPart(mob)
            if part then
                table.insert(hitList, { mob, part })
                if not primaryPart then primaryPart = part end
            end
        end
    elseif typeof(v) == "Instance" then
        local part = GetTargetHitPart(v)
        if part then
            table.insert(hitList, { v, part })
            primaryPart = part
        end
    end

    if primaryPart and #hitList > 0 then
        pcall(function()
            if ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack") then
                ReplicatedStorage.Modules.Net["RE/RegisterAttack"]:FireServer(0)
            end
            if ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit") then
                ReplicatedStorage.Modules.Net["RE/RegisterHit"]:FireServer(primaryPart, hitList)
            end
            if r and r.Parent then
                r:FireServer(encoded, hitId, primaryPart, hitList, nil, comboTag)
            end
        end)
    end
end

local function DieWait()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
    if LocalPlayer.Character.Humanoid.Health == 0 or not LocalPlayer.Character:FindFirstChild("Head") then 
