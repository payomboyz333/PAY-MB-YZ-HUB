function CombatManager:VerifyDamage(target)
    if not target or not target:FindFirstChild("Humanoid") then return true end
    local curHP = target.Humanoid.Health
    if self.LastTargetHP ~= nil and self.LastTargetHP == curHP then
        self.NoDamageCount = self.NoDamageCount + 1
        if self.NoDamageCount >= 6 then
            warn("[CombatManager]: Target HP unchanged after 6 hits! Refreshing target seed...")
            self.NoDamageCount = 0
            return false
        end
    else
        self.NoDamageCount = 0
    end
    self.LastTargetHP = curHP
    return true
end

