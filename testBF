KaitunMonitor.UIUpdateCallback = function()
    local isTH = (ObsidianGlassEngine and ObsidianGlassEngine.CurrentLanguage == "th")

    local curLvl = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")) and LocalPlayer.Data.Level.Value or 1
    if not KaitunMonitor.Stats.StartLevel then KaitunMonitor.Stats.StartLevel = curLvl end
    KaitunMonitor.Stats.CurrentLevel = curLvl
    KaitunMonitor.Stats.LevelsGained = math.max(0, curLvl - KaitunMonitor.Stats.StartLevel)

    local curBeli = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Beli")) and LocalPlayer.Data.Beli.Value or 0
    if not KaitunMonitor.Stats.StartBeli then KaitunMonitor.Stats.StartBeli = curBeli end
    KaitunMonitor.Stats.CurrentBeli = curBeli
    KaitunMonitor.Stats.BeliGained = math.max(0, curBeli - KaitunMonitor.Stats.StartBeli)

    local curFrags = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Fragments")) and LocalPlayer.Data.Fragments.Value or 0
    if not KaitunMonitor.Stats.StartFrags then KaitunMonitor.Stats.StartFrags = curFrags end
    KaitunMonitor.Stats.CurrentFrags = curFrags
    KaitunMonitor.Stats.FragsGained = math.max(0, curFrags - KaitunMonitor.Stats.StartFrags)

    local elapsed = os.time() - KaitunMonitor.Stats.StartTime
    local hrs = math.floor(elapsed / 3600)
    local mins = math.floor((elapsed % 3600) / 60)
    local secs = elapsed % 60
    local runtimeStr = string.format("%02d:%02d:%02d", hrs, mins, secs)

    local elapsedHours = math.max(0.001, elapsed / 3600)
    local speedVal = KaitunMonitor.Stats.LevelsGained / elapsedHours
    local speedStr = string.format("%.1f", speedVal)

    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    local hpPct = hum and math.floor((hum.Health / math.max(1, hum.MaxHealth)) * 100) or 100
    local hpStr = hum and string.format("%d%% (%d/%d)", hpPct, math.floor(hum.Health), math.floor(hum.MaxHealth)) or "0%"
    local energyObj = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Energy")
    local epPct = energyObj and math.floor((energyObj.Value / math.max(1, energyObj.MaxValue)) * 100) or 100
    local energyStr = energyObj and string.format("%d%% (%d/%d)", epPct, math.floor(energyObj.Value), math.floor(energyObj.MaxValue)) or "100%"

    local toolObj = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    local curWeapon = toolObj and toolObj.Name or (getgenv().Configs and getgenv().Configs.SelectWeapon) or "Melee"

    local pId = game.PlaceId
    local seaNum = (pId == 2753915549 and 1 or pId == 4442272183 and 2 or 3)
    local targetLvl = (seaNum == 1 and 700 or seaNum == 2 and 1500 or 2800)
    local lvlRem = math.max(0, targetLvl - curLvl)
    local etaStr = "N/A"
    if speedVal > 0.5 then
        local totalMins = math.floor((lvlRem / speedVal) * 60)
        local eHrs = math.floor(totalMins / 60)
        local eMins = totalMins % 60
        etaStr = (eHrs > 0) and string.format("%dh %dm", eHrs, eMins) or string.format("%dm", eMins)
    end

    local dCount = RecoveryService and RecoveryService.Deaths or 0
    local rCount = RecoveryService and RecoveryService.RecoveryCount or 0

    local hud = getgenv().KaitunHUD
    local hHeader = headerLabel or (hud and hud.Header)
    local hTitle = title or (hud and hud.Title)
    local hSubtitle = subtitle or (hud and hud.Subtitle)
    local hMobHp = mobHpLabel or (hud and hud.MobHp)
    local hMetrics = playerMetricsLabel or (hud and hud.PlayerMetrics)
    local hTime = TimeL or (hud and hud.Time)
    local hGains = gainsLabel or (hud and hud.Gains)

    pcall(function()
        if hHeader then
            hHeader.Text = isTH and "🥋 ระบบติดตามไก่ตัน (V8 Intelligence Brain)" or "🥋 KAITUN ENGINE MONITOR (LIVE)"
        end
        if hTitle then
            local statusText = KaitunMonitor.State.EngineStatus
            if not statusText or statusText == "INITIALIZING" then statusText = "🟢 FARMING" end
            hTitle.Text = isTH and string.format("สถานะ: %s | Sea %d (%s)", statusText, seaNum, KaitunMonitor.State.ProgressionMark)
                or string.format("Status: %s | Sea %d (%s)", statusText, seaNum, KaitunMonitor.State.ProgressionMark)
        end
        if hSubtitle then
            local objText = KaitunMonitor.State.ActiveObjective
            if not objText or objText == "LEVEL_FARM" then
                objText = Monster or NameCheckQuest or "Level & Quest Farming"
            end
            hSubtitle.Text = isTH and string.format("ภารกิจ: [%s] %s (ETA: %s)", KaitunMonitor.State.PriorityTier, objText, etaStr)
                or string.format("Objective: [%s] %s (ETA: %s)", KaitunMonitor.State.PriorityTier, objText, etaStr)
        end
        if hMobHp then
            local tm = getgenv().TargetManager or TargetManager
            local curTarget = tm and tm.CurrentTarget
            if curTarget and curTarget.Parent and curTarget:FindFirstChild("Humanoid") and curTarget.Humanoid.Health > 0 then
                local mHum = curTarget.Humanoid
                local mHp = math.floor(mHum.Health)
                local mMax = math.floor(math.max(1, mHum.MaxHealth))
                local pct = math.floor((mHp / mMax) * 100)
                local mCleanName = curTarget.Name:gsub(" %[Lv%. %d+%]", "")
                hMobHp.Text = string.format("👾 %s: %d%% (%d/%d)", mCleanName, pct, mHp, mMax)
                hMobHp.TextColor3 = pct > 50 and Color3.fromRGB(46, 224, 140) or (pct > 20 and Color3.fromRGB(255, 185, 70) or Color3.fromRGB(255, 70, 70))
            else
                local expected = Monster or KaitunMonitor.State.TargetMonster or "Scanning"
                hMobHp.Text = string.format("👾 Target: %s (Active)", tostring(expected))
                hMobHp.TextColor3 = Color3.fromRGB(150, 220, 255)
            end
        end
        if hMetrics then
            hMetrics.Text = isTH and string.format("💖 HP: %d%% | ⚡ พลังงาน: %d%% | ⚔️ %s", hpPct, epPct, curWeapon)
                or string.format("💖 HP: %d%% | ⚡ Energy: %d%% | ⚔️ %s", hpPct, epPct, curWeapon)
        end
        if hTime then
