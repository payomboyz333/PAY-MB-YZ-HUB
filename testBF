local function IsOwn(name)
    if not name then return nil end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild(name) then
        return bp:FindFirstChild(name)
    end
    local k
    if LocalPlayer.Character then
        for _, v in ipairs(LocalPlayer.Character:GetChildren()) do 
            if v:IsA("Tool") and v.Name == name then
                k = v
            end
        end
    end
    return k or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name))
end

local function IsPhysicalFruit(v)
    if not (v and v:IsA("Tool")) then return false end
    if v:FindFirstChild("EatRemote") or v:FindFirstChild("Eat") or v:FindFirstChild("EatFruit") then
        return true
    end
    local nameLower = v.Name:lower()
    if nameLower:match("%sfruit$") or nameLower:match("%sfruit%s") then
        return true
    end
    if v.ToolTip == "Consume" or (v.ToolTip == "Fruit" and not v:FindFirstChild("Level") and not v:FindFirstChild("Cooldown") and not v:FindFirstChild("Skills")) then
        return true
    end
    return false
end
getgenv().IsPhysicalFruit = IsPhysicalFruit

local function MatchesWeaponType(v, wType)
    if not (v and v:IsA("Tool")) then return false end
    if IsPhysicalFruit(v) then return false end
    local tt = v.ToolTip or ""
    local nameLower = v.Name:lower()
    if wType == "Blox Fruit" or wType == "Fruit" then
        if tt == "Blox Fruit" or tt == "Demon Fruit" then
            return true
        end
        if nameLower:find("%-") and not IsPhysicalFruit(v) then
            return true
        end
        if (nameLower:find("fruit") or v:FindFirstChild("Fruit")) and not IsPhysicalFruit(v) then
            return true
        end
    elseif wType == "Melee" then
        return tt == "Melee" or v.Name == "Combat" or v.Name == "Black Leg" or v.Name == "Electro" or v.Name == "Fishman Karate" or v.Name == "Dragon Claw" or v.Name == "Superhuman" or v.Name == "Death Step" or v.Name == "Sharkman Karate" or v.Name == "Electric Claw" or v.Name == "Dragon Talon" or v.Name == "Godhuman" or v.Name == "Sanguine Art"
    elseif wType == "Sword" then
        return tt == "Sword"
    elseif wType == "Gun" then
        return tt == "Gun"
    end
    return false
end

local function EquipWeapon(wType)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
    wType = wType or (getgenv().Configs and getgenv().Configs.SelectWeapon) or "Melee"
    
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if MatchesWeaponType(v, wType) then
            return v
        end
    end
    
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, v in pairs(bp:GetChildren()) do
            if MatchesWeaponType(v, wType) then
                LocalPlayer.Character.Humanoid:EquipTool(v)
                return v
            end
        end
    end
    
    if wType ~= "Melee" then
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == "Melee" or MatchesWeaponType(v, "Melee")) then return v end
        end
        if bp then
            for _, v in pairs(bp:GetChildren()) do
                if v:IsA("Tool") and (v.ToolTip == "Melee" or MatchesWeaponType(v, "Melee")) then
                    LocalPlayer.Character.Humanoid:EquipTool(v)
                    return v
                end
            end
        end
    end
end
getgenv().EquipWeapon = EquipWeapon

