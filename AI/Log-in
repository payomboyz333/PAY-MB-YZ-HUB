    -- Redeem Logic with Shake Animation & Cooldown Safeguard
    local busy = false
    local function redeemKey()
        if busy then return end

        if os.time() < cooldownUntil then
            local left = cooldownUntil - os.time()
            setStatus("🛑 Cooldown active! กรุณารอ " .. left .. " วินาที", COLORS.danger)
            ShowToast("🛑 Cooldown Active", "กรุณารออีก " .. left .. " วินาที ก่อนลองใหม่", "warn")
            return
        end

        local rawKey = input.Text or ""
        local key = rawKey:gsub("%s+", "")
        if key == "" then
            setStatus("กรุณากรอก Key ก่อนกดปุ่มนี้", COLORS.warning)
            ShowToast("⚠️ ข้อผิดพลาด", "กรุณากรอก Key ก่อนกดยืนยัน", "warn")
            return
        end

        -- 1. ตรวจสอบสิทธิ์ผ่าน KeyAI ก่อน (สำหรับ SuperVIP และ Special Customer)
        local keyAI = ResolveKeyAI()
        local isSuperVIP = keyAI and type(keyAI.IsSuperVIP) == "function" and keyAI.IsSuperVIP(key)
        local isSpecial = keyAI and type(keyAI.IsSpecialKey) == "function" and keyAI.IsSpecialKey(key)

        if isSuperVIP then
            busy = true
            setButtonEnabled(redeem, false)
            task.spawn(function()
                setButtonText(redeem, "[1/3] Verifying VVIP...")
                setStatus("👑 [1/3] Verifying VVIP Key...", COLORS.cyan)
                task.wait(0.3)
                setButtonText(redeem, "[2/3] Connecting...")
                setStatus("🚀 [2/3] Handshake KeyAI → Bypassing Luarmor...", COLORS.cyan)
                task.wait(0.3)
                setButtonText(redeem, "[3/3] Launching!")
                setStatus("✅ [3/3] VVIP Access Granted! Launching now...", COLORS.success)
                task.wait(0.35)
                if gui and gui.Parent then gui:Destroy() end
                PassToKeyChecker(key)
            end)
            return
        end

        if isSpecial then
            busy = true
            setButtonEnabled(redeem, false)
            task.spawn(function()
                setButtonText(redeem, "[1/2] Verifying Special Key...")
                setStatus("🔑 [1/2] Validating Customer Key...", COLORS.cyan)
                task.wait(0.3)
                setButtonText(redeem, "[2/2] Launching!")
                setStatus("✅ [2/2] Special Key Granted! Launching now...", COLORS.success)
                task.wait(0.35)
                if gui and gui.Parent then gui:Destroy() end
                PassToKeyChecker(key)
            end)
            return
        end

        -- 2. กรณีผู้ใช้ทั่วไป (Get Key): ตรวจสอบผ่านระบบ Luarmor API / SDK
        setButtonText(redeem, "Checking...")
        setStatus("🔍 กำลังตรวจสอบคีย์ Luarmor...", COLORS.cyan)

        local isLuarmorValid, luarmorReason = VerifyLuarmorKey(key)

        if not isLuarmorValid then
            failedAttempts = failedAttempts + 1

            -- 📳 Shake Box Animation
            task.spawn(function()
                local origPos = input.Position
                for i = 1, 6 do
                    local offset = (i % 2 == 0 and 8 or -8)
                    input.Position = origPos + UDim2.fromOffset(offset, 0)
                    task.wait(0.035)
                end
                input.Position = origPos
            end)

            ShowToast("❌ คีย์ไม่ถูกต้อง", luarmorReason or "กรุณาตรวจสอบคีย์แล้วลองใหม่อีกครั้ง", "error")

            if failedAttempts >= 3 then
                cooldownUntil = os.time() + 30
                failedAttempts = 0
                setStatus("🛑 ใส่คีย์ผิด 3 ครั้ง! Cooldown 30 วินาที", COLORS.danger)
                setButtonText(redeem, "🛑 Cooldown (30s)")
                task.spawn(function()
                    for s = 30, 1, -1 do
                        if os.time() >= cooldownUntil then break end
                        setButtonText(redeem, "🛑 Cooldown (" .. s .. "s)")
                        task.wait(1)
                    end
                    setButtonText(redeem, "Verify Key")
                end)
            else
                setStatus("❌ " .. (luarmorReason or "Key ไม่ถูกต้อง!") .. " (พยายามอีก " .. (3 - failedAttempts) .. " ครั้ง)", COLORS.warning)
                setButtonText(redeem, "Verify Key")
            end
            return
        end

        -- ผ่านการตรวจ Luarmor -> ดำเนินการเชื่อมต่อ Luarmor เต็มรูปแบบ (5 ขั้นตอน)
