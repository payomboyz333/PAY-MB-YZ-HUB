local CachedKeyAI = nil
local function ResolveKeyAI()
    if CachedKeyAI then return CachedKeyAI end
    pcall(function()
        local code = game:HttpGet(LuarmorConfig.KeyAI_URL .. "?t=" .. tostring(tick()))
        if code and #code > 0 then
            local fn = loadstring(code)
            if fn then CachedKeyAI = fn() end
        end
    end)
    if not CachedKeyAI and isfile and readfile then
        pcall(function()
            local paths = { "KeyAI.txt", "c:/Users/Dream/Desktop/Games/KeyAI.txt" }
            for _, p in ipairs(paths) do
                if isfile(p) then
                    local code = readfile(p)
                    if code and #code > 0 then
                        local fn = loadstring(code)
                        if fn then CachedKeyAI = fn(); break end
                    end
                end
            end
        end)
    end
    return CachedKeyAI
end

