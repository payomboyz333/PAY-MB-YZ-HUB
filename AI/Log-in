-- 🔒 ระบบตรวจสอบ Luarmor Public SDK สำหรับผู้ใช้ระบบ Get Key (Free Tier)
-- ==============================================================================
local LuarmorSDKCache = nil
local LuarmorSDKLoading = false
local function getLuarmorSDK()
    if LuarmorSDKCache then return LuarmorSDKCache end
    if LuarmorSDKLoading then
        local waited = 0
        while LuarmorSDKLoading and waited < 6 do
            task.wait(0.2)
            waited = waited + 0.2
            if LuarmorSDKCache then return LuarmorSDKCache end
        end
        return LuarmorSDKCache
    end
    LuarmorSDKLoading = true
    local ok, lib = pcall(function()
        return loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))()
    end)
    LuarmorSDKLoading = false
    if ok and type(lib) == "table" then
        LuarmorSDKCache = lib
        return lib
    end
    return nil
end

local function VerifyLuarmorKey(key)
    if not key or #key < 10 then
        return false, "❌ รูปแบบคีย์ไม่ถูกต้อง (ความยาวน้อยเกินไป)"
    end
    local sdk = getLuarmorSDK()
    if sdk then
        local targetIds = { LuarmorConfig.ScriptId, LuarmorConfig.ProjectId }
        for _, sid in ipairs(targetIds) do
            local status = nil
            pcall(function()
                sdk.script_id = sid
                status = sdk.check_key(key)
            end)
            if status and type(status) == "table" and status.code then
                if status.code == "KEY_VALID" then
                    return true, "✅ ยืนยันคีย์ Luarmor สำเร็จ"
                elseif status.code == "KEY_HWID_LOCKED" then
                    return false, "❌ คีย์นี้ติดล็อคเครื่องอื่น (กรุณารีเซ็ต HWID ในเว็บ)"
                elseif status.code == "KEY_EXPIRED" then
                    return false, "❌ คีย์นี้หมดอายุแล้ว กรุณารับคีย์ใหม่"
                elseif status.code == "KEY_BANNED" then
                    return false, "❌ คีย์นี้ถูกระงับการใช้งาน (Banned)"
                elseif status.code == "KEY_INVALID" then
                    -- ตรวจ ID ถัดไป
                end
            end
        end
    end
    -- กรณี SDK ติดต่อไม่ได้ชั่วคราว ให้ส่งต่อให้ Luarmor Loader ไปตรวจสอบเอง
    return true, "✅ ส่งคีย์เข้าสู่ระบบ Luarmor Loader"
end

local function PassToKeyChecker(userKey)
    if not userKey or userKey == "" then return end
    userKey = userKey:gsub("%s+", "")

    local keyAI = ResolveKeyAI()
    local isSpecial = false
    local isSuperVIP = false
    local targetURL = nil

    if keyAI then
        if type(keyAI.IsSuperVIP) == "function" and keyAI.IsSuperVIP(userKey) then
            isSuperVIP = true
            targetURL = keyAI.GetAIScriptURL(userKey)
        elseif type(keyAI.IsSpecialKey) == "function" and keyAI.IsSpecialKey(userKey) then
            isSpecial = true
            targetURL = keyAI.GetAIScriptURL(userKey)
        end
    end

    -- ปิด UI หน้า Loader ทันที
    pcall(function()
        local loaderGui = parentGui:FindFirstChild("PayomboyZ_SnowyLoader") or parentGui:FindFirstChild("PayomboyZ_HackerLoader")
        if loaderGui then loaderGui:Destroy() end
    end)

    -- 👑 1. กรณีเป็น VIP / Special Customer: บายพาส Luarmor และโหลดสคริปต์ตรงจาก Github AI/src
    if isSuperVIP or isSpecial then
        SaveKey(userKey)
        if getgenv then
            getgenv().PayomboyZ_UserKey = userKey
            getgenv().PayomboyZ_InputKey = userKey
            getgenv().PayomboyZ_VerifiedKey = userKey
            getgenv().PayomboyZ_Authenticated = true
            getgenv().PayomboyZ_LoaderLoaded = true
            getgenv().PayomboyZ_IsSuperVIP = isSuperVIP
            getgenv().PayomboyZ_IsSpecialKey = isSpecial
            getgenv().script_key = nil
        end
        if getrenv then pcall(function() getrenv().script_key = nil end) end
        if getfenv then pcall(function() getfenv().script_key = nil end) end
        _G.PayomboyZ_UserKey = userKey
        _G.PayomboyZ_InputKey = userKey
        _G.PayomboyZ_VerifiedKey = userKey
        _G.script_key = nil
        shared.PayomboyZ_UserKey = userKey
        shared.script_key = nil
        script_key = nil

        if isSuperVIP then
            ShowToast("👑 Super VIP Access", "ยินดีต้อนรับท่านผู้พัฒนา / SuperVIP!", false)
        else
            ShowToast("🔑 Special Key Verified", "ยินดีต้อนรับ! ผ่านการยืนยันด้วยคีย์ลูกค้าระดับพิเศษ", false)
        end

        if targetURL then
            local success, err = pcall(function()
                loadstring(game:HttpGet(targetURL .. "?t=" .. tostring(tick())))()
            end)
            if not success then
                ShowToast("❌ Error", "ไม่สามารถโหลดสคริปต์หลักได้: " .. tostring(err), true)
            end
        end
        return
    end

    -- 🛡️ 2. กรณีเป็นผู้ใช้ทั่วไป (Luarmor Get Key User): ยืนยันสิทธิ์ผ่าน Luarmor API แล้วโหลดสคริปต์หลักจาก GitHub AI/src
    local isLuKeyOk, luReason = VerifyLuarmorKey(userKey)
    if not isLuKeyOk then
        ShowToast("❌ คีย์ไม่ถูกต้อง", luReason or "คีย์ Luarmor ไม่ถูกต้องหรือหมดอายุ", true)
        CreateLoaderUI(luReason, userKey)
        return
    end

    SaveKey(userKey)
