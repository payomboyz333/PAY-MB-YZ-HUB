local function GetDynamicSupportedGames()
    local games = {}
    local nRouter = (getgenv and getgenv().PayomboyZ_NormalRouter) or _G.PayomboyZ_NormalRouter
    local vRouter = (getgenv and getgenv().PayomboyZ_VVIPRouter) or _G.PayomboyZ_VVIPRouter
    if type(nRouter) == "table" then
        for id, data in pairs(nRouter) do
            if data and data.Name then games[id] = data.Name end
        end
    end
    if type(vRouter) == "table" then
        for id, data in pairs(vRouter) do
            if data and data.Name then games[id] = data.Name .. " (VVIP)" end
        end
    end

    return games
end

local function resolveGameName()
    local placeId = game.PlaceId
    local supportedGames = GetDynamicSupportedGames()
    if supportedGames[placeId] then
        return supportedGames[placeId]
    end
    local gameName = nil
    pcall(function()
        local info = MarketplaceService:GetProductInfo(placeId)
        if info and info.Name then
            gameName = info.Name
        end
    end)
    return gameName or ("Place: " .. tostring(placeId))
end

