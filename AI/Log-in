    end)

    task.delay(10, function()
        if EscapeGui then pcall(function() EscapeGui:Destroy() end) end
    end)

    ShowToast("🔑 PayomboyZ Hub", "พบ Key เดิม! กำลังเชื่อมต่ออัตโนมัติ...", false)
    PassToKeyChecker(savedKey)
else
    CreateLoaderUI(nil, "")
end
