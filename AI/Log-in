            setButtonText(redeem, "[1/5] Checking...")
            setStatus("🔍 [1/5] Checking Key format...", COLORS.cyan); task.wait(0.3)
            setButtonText(redeem, "[2/5] Connecting...")
            setStatus("📡 [2/5] Connecting to Luarmor API...", COLORS.cyan); task.wait(0.3)
            setButtonText(redeem, "[3/5] Verifying...")
