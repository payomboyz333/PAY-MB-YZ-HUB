                if type(ores) == "table" then
                    for oreUuid, dropItem in pairs(ores) do
                        Stats.OresCollected = Stats.OresCollected + 1
                        -- ★ 2K.txt Logic: Claim ores via GetOreRF, Enchant Stones via GetEnhantStoneRE
