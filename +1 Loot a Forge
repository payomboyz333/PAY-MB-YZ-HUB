local function getPackInfo()
    local cur, maxNum = 0, 10
    local realOres = nil
    pcall(function()
        local bp = getBackpackItems()
        if bp then
            local count = 0
            for _, item in pairs(bp) do
                if type(item) == "table" and item.Type == "Ore" then
                    count = count + (tonumber(item.Number) or 1)
                end
            end
            realOres = count
        end
    end)
    pcall(function()
        local LeftInfoGUI = require(ReplicatedStorage.GuiUtils.LeftInfoGUI)
        cur = LeftInfoGUI.GetOrePack() or 0
        -- ★ FIX: Auto-synchronize LeftInfoGUI if desynced from real backpack
        if realOres ~= nil and State and State.GodSafeForgeFix and math.abs(cur - realOres) >= 1 then
            cur = realOres
            if LeftInfoGUI.UpdateOrePack then
                LeftInfoGUI.UpdateOrePack(realOres)
            end
        end
    end)
    pcall(function()
        local UpgradeData = require(ReplicatedStorage.LocalData.UpgradeData)
        maxNum = UpgradeData.GetMaxNum("OrePack") or 10
    end)
    return (realOres ~= nil and realOres or cur), maxNum
end

local function getBackpackItems()
    if not BackpackData then
