local function checkPlayerForStaffTraits(p)
    if not p or p == LocalPlayer then return false, nil end

    -- 1. Check Creator Owner ID & Game Creator
    local creatorId = game.CreatorId
    if (creatorId and p.UserId == creatorId) or (p.UserId == 7058882480) then
        return true, "Creator / Owner ID Match (" .. tostring(p.UserId) .. ")"
    end

    -- 2. Check Developer Group Rank (Group 828376264: Good Bro Studio)
    local groupId = State.StaffGroupId or 828376264
    local isInGroup = false
    local rank = 0
    local role = ""
    pcall(function()
        isInGroup = p:IsInGroup(groupId)
        if isInGroup then
            rank = p:GetRankInGroup(groupId)
            role = p:GetRoleInGroup(groupId) or ""
        end
    end)

    if isInGroup then
        if State.SentinelStrictGroup and rank >= 1 then
            return true, ("Strict Sentinel: Member of Creator Group (Rank " .. tostring(rank) .. " - " .. tostring(role) .. ")")
        elseif rank > 1 or role == "Admin" or role == "stella" or role == "Owner" then
            return true, ("Staff Rank " .. tostring(rank) .. " (" .. tostring(role) .. ") in Group " .. tostring(groupId))
        end
    end

    -- 3. Check Admin / Staff Attributes
    local isStaffAttr = false
    pcall(function()
        if p:GetAttribute("IsAdmin") or p:GetAttribute("Admin") or p:GetAttribute("Staff") or p:GetAttribute("Mod") or p:GetAttribute("Tester") or p:GetAttribute("Dev") then
            isStaffAttr = true
        end
    end)
    if isStaffAttr then
        return true, "Admin/Staff attribute flagged"
    end

    -- 4. Check Username & DisplayName Keywords
    local nameCombo = (tostring(p.Name) .. " " .. tostring(p.DisplayName)):lower()
    for _, kw in ipairs({ "[admin]", "[staff]", "[mod]", "[dev]", "admin_", "staff_", "mod_" }) do
        if nameCombo:find(kw, 1, true) then
            return true, ("Staff keyword found in name: " .. kw)
        end
    end

    return false, nil
end

local function checkAntiStaffSentinel()
    if not State.AntiStaffSentinel then return end
    for _, p in ipairs(Players:GetPlayers()) do
        local isStaff, reason = checkPlayerForStaffTraits(p)
        if isStaff then
            safeServerHop(p.Name .. " (" .. tostring(reason) .. ")")
