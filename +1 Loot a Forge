-- Core Engine 3: Super Loot Boss Hunter (Integrated Continuous Sniper)
-- ─────────────────────────────────────────────────────────────
local _isHuntingBoss = false
local _killedBossCache = {}
local _lastBossCachePrune = 0

local function findActiveSuperLootBoss()
    local enemyFolder = workspace:FindFirstChild("EnemyFolder")
    if not enemyFolder then return nil, nil end

    local now = os.clock()
    if now - _lastBossCachePrune >= 15.0 then
        _lastBossCachePrune = now
        for name, t in pairs(_killedBossCache) do
            if now - t > 30.0 then _killedBossCache[name] = nil end
        end
    end

    for _, e in ipairs(enemyFolder:GetChildren()) do
        if e:IsA("Model") and not e:GetAttribute("Dead") and not _killedBossCache[e.Name] then
            local enemyId = tostring(e:GetAttribute("EnemyID") or "")
            local hasBGM = e:FindFirstChild("HumanoidRootPart") and e.HumanoidRootPart:FindFirstChild("SuperLootBGM")
            local isBoss = enemyId:find("Super") or enemyId:find("SuperLoot") or hasBGM
            if isBoss then
                local hum = e:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health > 0 then
                    local rarity = e:GetAttribute("Rarity")
                    if not rarity then
                        local slf = workspace:FindFirstChild("SuperLootFolder")
                        if slf and #slf:GetChildren() > 0 then
                            rarity = slf:GetChildren()[1].Name
                        else
                            rarity = "SuperLoot"
                        end
                    end
                    return e, tostring(rarity)
                end
            end
        end
    end
    return nil, nil
end

local function executeSuperLootHunt(targetBossModel, bossRarity)
    if _isHuntingBoss then return end
    _isHuntingBoss = true

    -- ★ Step 2 FIX: r.Anchored + _isHuntingBoss guaranteed cleared on ALL exit paths
    local r = hrp()
    local function _cleanup()
        if r then pcall(function() r.Anchored = false end) end
        _isHuntingBoss = false
        if not isInFight() and (State.MasterTrainWhenIdle or State.AutoTrainBestZone) then
            task.defer(engageIdleTraining)
        end
    end

    local ok, err = pcall(function()
        disengageIdleTraining()
        local bossesKilledInSweep = 0

        while true do
            if not targetBossModel or not targetBossModel.PrimaryPart
                or targetBossModel:GetAttribute("Dead")
                or _killedBossCache[targetBossModel.Name] then
                targetBossModel, bossRarity = findActiveSuperLootBoss()
            end
            if not targetBossModel or not targetBossModel.PrimaryPart then break end

            if State.SuperLootTargetTier ~= "All"
                and bossRarity and bossRarity ~= "SuperLoot"
                and State.SuperLootTargetTier ~= bossRarity then
                _killedBossCache[targetBossModel.Name] = os.clock()
                targetBossModel = nil
            else
                local bossPivot = targetBossModel:GetPivot()
                if r then
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                    r.CFrame = CFrame.new(bossPivot.Position + Vector3.new(0, 14, 0))
                    r.Anchored = true
                end

                Stats.CurrentActivity = TF("StatusSuperLootHunt", bossRarity or "SuperLoot")
                if bossesKilledInSweep == 0 then
                    notify(
                        State.Language == "TH" and "ล่าบอสแร่ยักษ์" or "Super Loot Hunter",
                        TF("Notif_BossAcquired", bossRarity or "SuperLoot"),
                        "crosshair"
                    )
                end

                if State.NotifySuperLoot and State.WebhookEnabled and bossesKilledInSweep == 0 then
                    local isTH = State.Language == "TH"
                    sendWebhook(
                        isTH and "ตรวจพบบอสแร่ยักษ์เป้าหมาย!" or "Super Loot Target Engaged",
                        isTH and "ระบบสไนป์บอสเข้าโจมตีและเก็บเกี่ยวของรางวัลเรียบร้อย" or "Autonomous sniper intercepted active Super Loot.",
                        {
                            { name = isTH and "ระดับความหายาก" or "Tier / Rarity",  value = tostring(bossRarity or "SuperLoot"), inline = true },
                            { name = isTH and "พิกัดเป้าหมาย"  or "Coordinates",     value = tostring(bossPivot.Position),        inline = true },
                        },
                        0xEF4444
                    )
                end

                task.wait(0.08)
                instantKillEnemy(targetBossModel)
                call("SuperLoot", "KillSuperLootRE", targetBossModel.Name)
                if Bindable_EnemyHit then
                    pcall(function()
                        Bindable_EnemyHit:Fire(targetBossModel.Name, 1e30, { SkillID = "K_Skill_1_ATK" })
                    end)
                end
                pcall(function()
                    local ec = require(ReplicatedStorage.CTRL.EnemyCTRL)
                    if ec then
                        if ec.HurtEnemy  then ec.HurtEnemy(targetBossModel.Name, "100%", { SkillID = "K_Skill_1_ATK" }) end
                        if ec.DeadEnemyData then ec.DeadEnemyData(targetBossModel.Name, { NotDeadVFX = true }) end
                    end
                end)
                _killedBossCache[targetBossModel.Name] = os.clock()
                targetBossModel:SetAttribute("Dead", true)
                Stats.SuperLootKills = Stats.SuperLootKills + 1
                bossesKilledInSweep = bossesKilledInSweep + 1

                task.wait(0.15)
                if State.DropMagnet then pcall(runDropMagnet) end
                if State.UltraPrompt then pcall(runUltraPrompts) end
                targetBossModel = nil
                task.wait(0.05)
            end
        end
    end)

    if not ok and State.Debug then
        if State and State.Debug then warn("[PAYOMBØYZ] executeSuperLootHunt error:", tostring(err)) end
    end
    _cleanup()
end

local function checkSuperLootHunter()
    if not (State.SuperLootHunter or (State.Master247 and State.MasterAutoHuntBosses)) then return end
    if isInDungeon() then return end
    local boss, rarity = findActiveSuperLootBoss()
    if boss then
        executeSuperLootHunt(boss, rarity)
    end
end

