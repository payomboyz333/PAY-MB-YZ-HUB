    return ok and type(data) == "table" and type(data.have) == "table" and data.have or nil
end


-- ★ ALGORITHMIC DPS & AFFIX SOLVER AI (Mathematical Synergy Matrix)
Dynamic.getItemRarityAndConfig = function(item)
    if type(item) ~= "table" then return "", nil end
    local idStr = tostring(item.ID or "")
    local cfg = nil
    pcall(function()
        if item.Type == "Weapon" then
            local wc = WeaponConfig or (ReplicatedStorage.Config:FindFirstChild("Weapon") and require(ReplicatedStorage.Config.Weapon.Config))
            if wc then cfg = wc[idStr] end
        else
            local ac = ArmorConfig or (ReplicatedStorage.Config:FindFirstChild("Armor") and require(ReplicatedStorage.Config.Armor.Config))
            if ac then cfg = ac[idStr] end
        end
    end)
    local rarity = ""
    if cfg and cfg.Rarity then
        rarity = tostring(cfg.Rarity)
    else
        rarity = tostring(item.RarityLevel or item.Rarity or item.RareLevel or item.Rare or "")
    end
    return rarity, cfg
end

local function calculateEffectiveDPS(item)
    if type(item) ~= "table" or not item.ID then return 0 end

    local id = tostring(item.ID or "")
    local slot = item.Type or "Weapon"
    local rarity, cfg = Dynamic.getItemRarityAndConfig(item)
    local enhLevel = tonumber(item.EnchanceNum or item.EnhanceNum) or 0

    -- ★ GOD / EXCLUSIVE TIER OVERRIDE (Absolute Tier Priority)
    if rarity == "Exclusive" or id:find("1101") or id:find("1001") or id:find("1002") or (cfg and cfg.BestPercent) then
        local mult = tonumber(cfg and (cfg.AttriNum or cfg.Train)) or 1.85
        return 1e16 + (mult * 1e14) + (enhLevel * 1e8)
    end
    if rarity == "Infinite" or id == "K_26" then
        return 9e15 + (enhLevel * 1e8)
    end
    if rarity == "Ancient" then
        return 8e15 + (enhLevel * 1e8)
    end
    if rarity == "Eternal" or id:find("16") then
        return 7e15 + (enhLevel * 1e8)
    end
    if rarity == "Secret" then
        return 6e15 + (enhLevel * 1e8)
    end
    if rarity == "Mythic" then
        return 5e15 + (enhLevel * 1e8)
    end

    local baseTrain = 1
    local usePower = 1
    pcall(function()
        if slot == "Weapon" and WeaponHelper and WeaponHelper.GetConfig then
            local wcfg = WeaponHelper.GetConfig(id)
            if wcfg then
                baseTrain = tonumber(wcfg.Train) or 1
                usePower = tonumber(wcfg.UsePower) or 1
            end
        elseif (slot == "Armor" or slot == "Hat") and ArmorHelper and ArmorHelper.GetConfig then
            local acfg = ArmorHelper.GetConfig(id)
            if acfg then
                baseTrain = tonumber(acfg.BaseWeight or acfg.Train) or 1
                usePower = tonumber(acfg.UsePower) or 1
            end
        end
    end)

    local enhBoost = 0
    pcall(function()
        local eh = EnhantHelper or require(ReplicatedStorage.Config.Enhant.Helper)
        if eh and eh.GetBoost then
            enhBoost = eh.GetBoost(enhLevel) or 0
        end
    end)

    local totalCritRate = 0
    local totalCritDmg = 1.0
    local damageInterval = 0.5
    pcall(function()
        local sh = EnchStoneHelper or require(ReplicatedStorage.Config.EnchStone.Helper)
        if sh and item.EnchanceList and type(item.EnchanceList) == "table" then
            for _, stoneId in ipairs(item.EnchanceList) do
                local sc = sh.GetStoneConfig(stoneId)
                if sc then
                    totalCritRate = totalCritRate + (tonumber(sc.BoomPercent) or 0)
                    totalCritDmg = totalCritDmg + (tonumber(sc.BoomValue) or 0)
                    if sc.DamageInterval and tonumber(sc.DamageInterval) < damageInterval then
                        damageInterval = tonumber(sc.DamageInterval)
                    end
                end
            end
        end
    end)

    local affixBonus = 1.0
    if item.MainAffix and type(item.MainAffix) == "table" then
        local num = tonumber(item.MainAffix.Number) or 0
        affixBonus = affixBonus + (num * 0.05)
    end
    if item.Affix and type(item.Affix) == "table" then
        for _, sub in ipairs(item.Affix) do
            if type(sub) == "table" and sub.Number then
                affixBonus = affixBonus + (tonumber(sub.Number) or 0) * 0.03
            end
        end
    end

    local dps = (baseTrain * usePower * (1 + enhBoost) * affixBonus)
        * (1 + (totalCritRate * totalCritDmg))
        * (1 / math.max(damageInterval, 0.1))

    return dps
end

local _uuidDpsCache = {} -- [uuid] = { score = number, enh = number, level = number, enchCount = number }
local function getCachedEffectiveDPS(item, uuid)
    if type(item) ~= "table" then return 0 end
    uuid = uuid or item.UUID or item.uuid
    local enhLevel = tonumber(item.EnchanceNum or item.EnhanceNum) or 0
    local itemLevel = tonumber(item.Level or item.level) or 0
    local enchCount = (item.EnchanceList and type(item.EnchanceList) == "table") and #item.EnchanceList or 0

    if uuid then
        local entry = _uuidDpsCache[uuid]
        if entry and entry.enh == enhLevel and entry.level == itemLevel and entry.enchCount == enchCount then
            return entry.score
        end
    end

    local dps = calculateEffectiveDPS(item)
    if uuid then
        _uuidDpsCache[uuid] = {
            score = dps,
            enh = enhLevel,
            level = itemLevel,
            enchCount = enchCount
        }
    end
    return dps
end

local function itemGearScore(item, uuid)
    if type(item) ~= "table" or item.ID == nil then return 0 end
    local idStr = tostring(item.ID or "")
    local rarity, cfg = Dynamic.getItemRarityAndConfig(item)
    local enhLevel = tonumber(item.EnchanceNum or item.EnhanceNum) or 0

    -- ★ ABSOLUTE GOD TIER PRIORITY (Prevents any gear swapping conflicts)
    if rarity == "Exclusive" or idStr:find("1101") or idStr:find("1001") or idStr:find("1002") or (cfg and cfg.BestPercent) then
        local mult = tonumber(cfg and (cfg.AttriNum or cfg.Train)) or 1.85
        return 1e16 + (mult * 1e14) + (enhLevel * 1e8)
    end
    if rarity == "Infinite" or idStr == "K_26" then
        return 9e15 + (enhLevel * 1e8)
    end
    if rarity == "Ancient" then
        return 8e15 + (enhLevel * 1e8)
    end
    if rarity == "Eternal" or idStr:find("16") then
        return 7e15 + (enhLevel * 1e8)
    end
    if rarity == "Secret" then
        return 6e15 + (enhLevel * 1e8)
    end
    if rarity == "Mythic" then
        return 5e15 + (enhLevel * 1e8)
    end

    if State.AlgorithmicDPSSolver then
        return getCachedEffectiveDPS(item, uuid)
    end

    local designPower = 0
    local helper = item.Type == "Weapon" and WeaponHelper or ArmorHelper
    if helper and type(helper.GetDesignPower) == "function" then
        pcall(function() designPower = tonumber(helper.GetDesignPower(item.ID)) or 0 end)
    end

    local rarityRanks = {
        Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5,
        Mythic = 6, Eternal = 7, Secret = 8, Ancient = 9, Infinite = 10,
        Exclusive = 100,
    }
    local rRank = rarityRanks[rarity] or 0
    local affix = type(item.MainAffix) == "table" and tonumber(item.MainAffix.Number) or 0
    local enhancement = enhLevel
    return rRank * 1000000000 + designPower * 100000 + (affix or 0) + enhancement * 10
end

