-- ★ DUNGEON HOVER ENGINE: Steady float in dungeon airspace for maximum EXP & zero damage
local function maintainDungeonHover()
    local inDung = isInDungeon() or isInTower()
    local r = hrp()
    if not r then return end

    -- Floating is specifically designed for INSIDE the Dungeon to safely harvest EXP
    if not (State.Master247 or State.AutoDungeon or State.AutoTower or State.DungeonFloatExp or State.TowerFloatExp) or not inDung then
        if r.Anchored and not State.Frozen then
            r.Anchored = false
        end
        return
    end

    local height = (State.AutoTower and tonumber(State.TowerFloatHeight)) or tonumber(State.DungeonFloatHeight) or 28
    local dm = workspace:FindFirstChild("WorldModel") and workspace.WorldModel:FindFirstChild("DungeonMap")
    local sp = dm and dm:FindFirstChild("StartPoint")

    pcall(function()
        local targetY = 23 + height
        if sp and sp.Position then
            targetY = sp.Position.Y + height
        end
        local cur = r.Position
        if math.abs(cur.Y - targetY) > 2.0 or (cur - Vector3.new(3482, targetY, -4)).Magnitude > 60 then
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
            r.CFrame = CFrame.new(cur.X, targetY, cur.Z)
        end
        -- Anchoring eliminates 100% of gravity calculations and PhysX velocity thrashing
        if not r.Anchored then
            r.Anchored = true
        end
    end)
end

-- ★ DUNGEON / TOWER — primary farm loop (runs when tickets available)
local _lastDungeonEnterTick = 0
local function runDungeonLoop(force)
    if not force and not (State.AutoDungeon or State.AutoTower or (State.Master247 and (State.MasterDungeonTicket or State.MasterTowerTicket))) then return end
    if checkSafeEvacuate() then return end
    if _isHuntingBoss then return end

    local isDungeoning = isInDungeon() or isInTower()
    local now = os.clock()

    if not isDungeoning then
        if now - _lastDungeonEnterTick < 3.0 then return end
        _lastDungeonEnterTick = now

        local tickets = getDungeonTicketCount()
        if tickets <= 0 and (State.AutoClaimTicket or State.AutoClaimTowerTicket) then
            call("Dungeon", "TryClaimDailyDunTicRE")
            call("Tower", "TryClaimDailyTowerTicRE")
            call("Tower", "TryClaimDailyTicRE")
            task.wait(0.5)
            tickets = getDungeonTicketCount()
        end
        if tickets <= 0 then return end

        -- หากตัวละครอยู่ในโหมดต่อสู้อื่น ให้บังคับออกจากไฟท์ทันทีเพื่อเข้าทาวเวอร์/ดันเจี้ยน
        if LocalPlayer:GetAttribute("IntoFight") then
            pcall(function()
                local su = require(LocalPlayer.PlayerScripts.Manager.StageManager.StageUtils)
                if su and su.ExitFight then su.ExitFight() end
            end)
            task.wait(0.5)
        end

        local targetRound = (State.AutoTower and tonumber(State.TowerRound)) or tonumber(State.DungeonRound) or tonumber(State.TowerRound) or 1
        Stats.CurrentActivity = TF("StatusDungeonEnter", tostring(targetRound))
        local ok = call("Dungeon", "TryIntoDungeonRF", targetRound)
        task.wait(0.8)
        if ok or isInDungeon() or isInTower() then
            call("Dungeon", "StartRoundRE", targetRound)
        end
    else
        local dmEnv, u140 = getDungeonManagerEnv()
        local currentRound = tonumber(LocalPlayer:GetAttribute("CurrentRound"))
            or (u140 and tonumber(u140.Round))
            or (State.AutoTower and tonumber(State.TowerRound))
            or tonumber(State.DungeonRound)
            or 1
        local isBlitzing = State.GodFarmStageBlitz or (State.Master247 and State.MasterStageBlitz)
        if isBlitzing then
            Stats.CurrentActivity = State.Language == "TH"
                and ("★ ทาวเวอร์ Round " .. tostring(currentRound) .. " + GOD-Farm คู่ขนาน")
                or  ("★ Tower Round " .. tostring(currentRound) .. " + GOD-Farm Blitz")
        else
            Stats.CurrentActivity = TF("StatusDungeonHover", tostring(currentRound))
        end

        -- Maintain steady float in the air for maximum safe EXP gain
        if State.DungeonFloatExp or State.TowerFloatExp then
            maintainDungeonHover()
        end

        local enemyFolder = workspace:FindFirstChild("EnemyFolder")
        local hitBE = Bindable_EnemyHit or getBindable("Attack", "EnemyHitBE")
        local aliveCount = 0

        if enemyFolder then
            for _, em in ipairs(enemyFolder:GetChildren()) do
                if em:IsA("Model") and not em:GetAttribute("Dead") then
                    aliveCount = aliveCount + 1
                    if hitBE then
                        hitBE:Fire(em.Name, 1e30, { SkillID = "K_Skill_1_ATK" })
                    end
                end
            end
        end

