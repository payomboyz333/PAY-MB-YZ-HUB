    local gameMaxStage = 27
    pcall(function()
        local loots = require(ReplicatedStorage.Config.Stage.Loots)
        if type(loots) == "table" then
            local count = 0
            for k in pairs(loots) do
                local n = tonumber(tostring(k):match("Stage_(%d+)"))
                if n and n > count then count = n end
            end
            if count > 0 then gameMaxStage = count end
        end
    end)
    local targetLimit = tonumber(State.GodMaxStageTarget) or 50
    local maxStages = math.min(targetLimit, gameMaxStage)

    pcall(function()
        for i = 1, maxStages do
            if not (State.GodModeStageBlitz50 or State.GodFarmStageBlitz or (State.Master247 and State.MasterStageBlitz)) then break end
            if checkSafeEvacuate() then break end

            local stageId = "Stage_" .. i
            local ok, ores = pcall(function()
                return stageFinishedRF:InvokeServer(stageId)
            end)

            if ok then
                Stats.LastStageClear = os.time()
