            sectionConfig = type(sectionConfig) == "table" and sectionConfig or {}
            self.SectionHandle = self.Native:CreateSection({
                Name = sectionConfig.Title or sectionConfig.Name or "Section",
                Description = sectionConfig.Description or sectionConfig.Desc or "",
