-- Unified Fight & Dungeon State Detectors (Fixes nil Dungeoning attribute bug)
local function isInDungeon()
    local fight = LocalPlayer:GetAttribute("IntoFight")
    return fight == "Dungeon" or LocalPlayer:GetAttribute("Dungeoning") == true
end

local function isInStage()
    local fight = LocalPlayer:GetAttribute("IntoFight")
    if fight == "Stage" then return true end
    local sId = LocalPlayer:GetAttribute("StageID")
    if type(sId) == "string" and sId:find("Stage") then return true end
    if type(sId) == "number" and sId > 0 then return true end
    return false
end

local function isInTower()
    local fight = LocalPlayer:GetAttribute("IntoFight")
    return fight == "Tower" or LocalPlayer:GetAttribute("InTower") == true or LocalPlayer:GetAttribute("Towering") == true
end

local function isInFight()
    return LocalPlayer:GetAttribute("IntoFight") ~= nil or isInDungeon() or isInStage() or isInTower()
end


