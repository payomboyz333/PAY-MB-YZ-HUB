                        end
                    end
                end
            end

            local delay = tonumber(State.StageBlitzInterval) or 0.03
            task.wait(math.max(delay, 0.02))
        end

        -- ★ 2K.txt Technique: Stage 27 Multi-Batch Rapid Enchant Stone Harvesting
        if (State.GodModeStageBlitz50 or State.GodFarmStageBlitz) and gameMaxStage >= 27 then
            local topStage = "Stage_" .. tostring(gameMaxStage)
            for batch = 1, 6 do
                local okTop, topDrops = pcall(function()
                    return stageFinishedRF:InvokeServer(topStage)
                end)
                if okTop and type(topDrops) == "table" then
                    for uuid, item in pairs(topDrops) do
                        if type(item) == "table" then
                            if getEnhantStoneRE then pcall(function() getEnhantStoneRE:FireServer(uuid) end) end
                        else
                            if getOreRF then pcall(function() getOreRF:InvokeServer(uuid) end) end
                        end
                    end
                end
            end
        end

        if claimedAllOreRE then
            pcall(function() claimedAllOreRE:FireServer() end)
        end
        -- Deferred in-flight Forge check: forge weapons/armor after ores accumulate without blocking blitz
        if (State.MasterConcurrentForge or State.AutoForge or (State.Master247 and State.MasterAutoForgeWhenReady)) then
            task.defer(function()
