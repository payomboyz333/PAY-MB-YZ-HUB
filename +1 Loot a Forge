local ActiveThreads = {}
local function loop(flag, delay, fn)
    if ActiveThreads[flag] then return end
    ActiveThreads[flag] = true
    local th = task.spawn(function()
        while Runtime.Running and State[flag] do
            local isMasterManaging = State.Master247 and (
                flag == "AutoDungeon" or flag == "AutoStage" or flag == "AutoSell" or
                flag == "AutoSellTrashGear" or flag == "AutoForge" or flag == "AutoUpgrade" or flag == "AutoRebirth"
            )
            if not isMasterManaging then
                local ok, err = pcall(fn)
                if not ok and State.Debug then warn("[PAYOMBØYZ Loop Error]:", flag, err) end
            end
            local waitTime = type(delay) == "string" and State[delay] or delay
            task.wait(math.max(waitTime or 0.1, 0.05))
        end
        ActiveThreads[flag] = nil
    end)
    table.insert(Runtime.Threads, th)
end

