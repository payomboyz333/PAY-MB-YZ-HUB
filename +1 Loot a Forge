Dynamic.resolveRaceClass = function(name)
    if not name then return "Class_6" end
    local s = tostring(name):lower()
    if s:find("angel") or s:find("เทวทูต") or s == "class_9" then return "Class_9" end
    if s:find("demon") or s:find("ปีศาจ") or s == "class_8" then return "Class_8" end
    if s:find("void") or s:find("วอยด์") or s:find("elf") or s == "class_7" then return "Class_7" end
    if s:find("dragon") or s:find("ดรากอน") or s:find("มังกร") or s == "class_6" then return "Class_6" end
    if s:find("vampire") or s:find("แวมไพร์") or s == "class_5" then return "Class_5" end
    if s:find("yeti") or s:find("เยติ") or s == "class_4" then return "Class_4" end
    if s:find("skeleton") or s:find("สเกเลตัน") or s == "class_3" then return "Class_3" end
    if s:find("goblin") or s:find("ก็อบลิน") or s == "class_2" then return "Class_2" end
    if s:find("human") or s:find("มนุษย์") or s == "class_1" then return "Class_1" end
    return (RaceNameMap and RaceNameMap[name]) or "Class_6"
end

Dynamic.getRaceSlotAnalysis = function(targetClass)
    local cd = nil
    pcall(function() cd = require(ReplicatedStorage.LocalData.ClassData) end)
    if not cd then return nil end

    local data = cd.GetData()
    if not data or not data.have then return nil end

    targetClass = targetClass or "Class_6"
    local targetRank = Dynamic.RACE_RANKS[targetClass] or 6
    local activeSlots = {}
    local bestSlot = nil

    for slotIdxStr, classId in pairs(data.have) do
        local idxStr = tostring(slotIdxStr)
        local isLocked = cd.IsLockedIndex(idxStr) == true
        local rank = Dynamic.RACE_RANKS[classId] or 1
        local isTarget = (classId == targetClass) or (rank >= targetRank)
        local slotInfo = {
            index = idxStr,
            classId = classId,
            rank = rank,
            isLocked = isLocked,
            isTarget = isTarget,
        }
        table.insert(activeSlots, slotInfo)

        if not bestSlot or rank > bestSlot.rank then
            bestSlot = slotInfo
        end
    end

    table.sort(activeSlots, function(a, b) return tonumber(a.index) < tonumber(b.index) end)

    -- Filter slots that can be rerolled: Must NOT be locked, and must NOT have hit target race
    local eligible = {}
    for _, s in ipairs(activeSlots) do
        if not s.isLocked and not s.isTarget then
            table.insert(eligible, s)
        end
    end

    -- Smart selection: Pick the slot with the LOWEST rank (worst race) to reroll!
    local worstEligibleSlot = nil
    if #eligible > 0 then
        table.sort(eligible, function(a, b)
            if a.rank ~= b.rank then
                return a.rank < b.rank -- Lowest rank first!
            end
            return tonumber(a.index) > tonumber(b.index)
        end)
        worstEligibleSlot = eligible[1]
    end

    return {
        activeSlots = activeSlots,
        bestSlot = bestSlot,
        worstEligibleSlot = worstEligibleSlot,
        targetRank = targetRank,
        targetClass = targetClass,
    }
end

local _lastRaceRollTick = 0
local function runRaceRerollLoop()
    if not (State.AutoRollRace or (State.Master247 and State.MasterAutoRollRaces)) then return end
    local now = os.clock()
    if now - _lastRaceRollTick < (tonumber(State.RollRaceDelay) or 1.0) then return end
    _lastRaceRollTick = now

    local cd = nil
    pcall(function() cd = require(ReplicatedStorage.LocalData.ClassData) end)
    if not cd then return end

    local luckTimes = (cd.GetLuckTimes and cd.GetLuckTimes()) or 0
    if luckTimes <= 0 then
        State.AutoRollRace = false
        State.MasterAutoRollRaces = false
        return
    end

    local targetClass = Dynamic.resolveRaceClass(State.TargetRaceToLock or State.TargetClassToLock)
    local analysis = Dynamic.getRaceSlotAnalysis(targetClass)
    if not analysis then return end

    local setLockRE = getRemote("Class", "SetIndexLockRE")
    local changeEquipRE = getRemote("Class", "ChangeEquipedIndexRE")
    local luckOnceRE = getRemote("Class", "LuckOnceRE")

    -- STEP 1: Auto-Lock ANY slot that has hit the target race (or higher tier)
    for _, s in ipairs(analysis.activeSlots) do
        if s.isTarget and not s.isLocked then
            if setLockRE then
                setLockRE:FireServer(s.index, true) -- Pass true explicitly to prevent toggle mismatch!
                s.isLocked = true
            end
            local hitName = RaceClassToDisplayName[s.classId] or s.classId
            notify(
                State.Language == "TH" and "ล็อกเผ่าสำเร็จ!" or "Race Locked!",
                State.Language == "TH"
                    and ("สล็อต " .. s.index .. " ได้เผ่า " .. hitName .. " ล็อกถาวรเรียบร้อย")
                    or  ("Slot " .. s.index .. " hit " .. hitName .. " and has been locked!"),
                "lock"
            )
        end
    end

    -- STEP 2: Always equip the highest tier race slot
    if analysis.bestSlot and cd.GetEquipedIndex() ~= analysis.bestSlot.index then
        if changeEquipRE then
            changeEquipRE:FireServer(analysis.bestSlot.index)
        end
    end

    -- STEP 3: If no eligible slots remain to reroll (all slots reached target or are locked)
    if not analysis.worstEligibleSlot then
        State.AutoRollRace = false
        State.MasterAutoRollRaces = false
        local bestName = RaceClassToDisplayName[analysis.bestSlot.classId] or analysis.bestSlot.classId
        notify(
            State.Language == "TH" and "สุ่มเผ่าสำเร็จ!" or "Race Gacha Complete!",
            State.Language == "TH"
                and ("ทุกสล็อตได้เผ่าระดับสูง/เป้าหมายแล้ว (" .. bestName .. ")")
                or  ("Target race secured across slots: " .. bestName),
            "sparkles"
        )
        return
    end

    -- STEP 4: Smart Reroll — Target the WORST slot to reroll, keeping better slots safe
    local rollSlot = analysis.worstEligibleSlot
    local currentRaceName = RaceClassToDisplayName[rollSlot.classId] or rollSlot.classId
    Stats.CurrentActivity = State.Language == "TH"
        and ("สุ่มเผ่าสล็อต " .. rollSlot.index .. " (ปัจจุบัน: " .. currentRaceName .. ")")
        or  ("Rolling Race Slot " .. rollSlot.index .. " (Current: " .. currentRaceName .. ")")

    _isRaceRerolling = true
    if luckOnceRE then
        luckOnceRE:FireServer(rollSlot.index)
    elseif cd.LuckOnce then
        cd.LuckOnce(rollSlot.index)
    end
    task.delay(0.6, function() _isRaceRerolling = false end)

    if State.AutoRollSkills then
        call("Backpack", "LuckSkillCell_2RE")
    end
end

