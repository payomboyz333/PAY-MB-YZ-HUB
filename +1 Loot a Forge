            })
            return self.SectionHandle
        end
        function adapter:Toggle(control)
            return self.SectionHandle:CreateToggle({
                Name = control.Title, Note = control.Desc, Default = control.Value,
                Callback = function(value)
                    if not UIRebuilding and type(control.Callback) == "function" then control.Callback(value) end
                end,
            })
        end
        function adapter:Button(control)
            return self.SectionHandle:CreateButton({ Name = control.Title, Note = control.Desc, Icon = "spark", Callback = control.Callback })
        end
        function adapter:Dropdown(control)
            return self.SectionHandle:CreateDropdown({ Name = control.Title, Note = control.Desc, Options = control.Values or {}, Default = control.Value, Callback = control.Callback })
        end
        function adapter:Slider(control)
            local range = type(control.Value) == "table" and control.Value or {}
            return self.SectionHandle:CreateSlider({
                Name = control.Title, Note = control.Desc,
                Min = range.Min or 0, Max = range.Max or 100,
                Default = range.Default or range.Min or 0, Rounding = range.Rounding,
                Callback = control.Callback,
            })
        end
        function adapter:Input(control)
            return self.SectionHandle:CreateInput({
                Name = control.Title, Note = control.Desc,
                Placeholder = control.Placeholder or "", Default = control.Value or control.Default or "",
                MaxLength = control.MaxLength, Callback = control.Callback,
            })
        end
        function adapter:Paragraph(control)
            if not self.SectionHandle then
                self:Section({ Title = "General", Side = "Left" })
            end
            local paragraph = self.SectionHandle:CreateCallout({
                Name = control.Title or "Notice",
                Text = control.Desc or control.Text or "",
                Kind = control.Kind or "Info",
            })
            pcall(function()
                if paragraph then
                    local inst = paragraph.Instance or (paragraph.Native and paragraph.Native.Instance)
                    if inst and inst:IsA("GuiObject") then
                        inst.AutomaticSize = Enum.AutomaticSize.Y
                    end
                    local lbl = (paragraph.Native and paragraph.Native.TextLabel) or paragraph.TextLabel
                    if lbl and lbl:IsA("TextLabel") then
                        lbl.AutomaticSize = Enum.AutomaticSize.Y
                        lbl.Size = UDim2.new(1, -30, 0, 0)
                        lbl.TextWrapped = true
                    end
                end
            end)
            return {
                SetDesc = function(_, text)
                    if paragraph then
                        if type(paragraph.Set) == "function" then
                            pcall(function() paragraph:Set(text) end)
                        elseif paragraph.Native and type(paragraph.Native.Set) == "function" then
                            pcall(function() paragraph.Native:Set(text) end)
                        end
                    end
                end,
                Set = function(_, text)
                    if paragraph then
