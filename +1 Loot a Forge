-- Universal Toast & Orphan GUI Purge Function
-- ─────────────────────────────────────────────────────────────
local _cachedToastLayer = nil
local _cachedToastStack = nil

local function purgeAllToastLayers(onlyToasts)
    -- Fast Path: Direct cached pointer eliminates game-wide hierarchy traversal
    if _cachedToastLayer and _cachedToastLayer.Parent then
        if onlyToasts then
            if _cachedToastStack and _cachedToastStack.Parent then
                for _, t in ipairs(_cachedToastStack:GetChildren()) do
                    if t:IsA("GuiObject") then pcall(function() t:Destroy() end) end
                end
                return
            end
        else
            pcall(function() _cachedToastLayer:Destroy() end)
            _cachedToastLayer = nil
            _cachedToastStack = nil
            return
        end
    end

    -- Initial discovery fallback
    local parents = {}
    pcall(function()
        if typeof(gethui) == "function" then
            local h = gethui()
            if h and not table.find(parents, h) then table.insert(parents, h) end
        end
    end)
    pcall(function()
        local cg = (typeof(cloneref) == "function" and cloneref(game:GetService("CoreGui"))) or game:GetService("CoreGui")
        if cg and not table.find(parents, cg) then table.insert(parents, cg) end
    end)
    pcall(function()
        local lp = game:GetService("Players").LocalPlayer
        if lp then
            local pg = lp:FindFirstChildOfClass("PlayerGui")
            if pg and not table.find(parents, pg) then table.insert(parents, pg) end
        end
    end)

    for _, parent in ipairs(parents) do
        pcall(function()
            for _, child in ipairs(parent:GetChildren()) do
                -- Clear orphan click-blocking dropdown fullscreen buttons
                if child.Name:find("DropDown") or child.Name:find("Fullscreen") then
                    pcall(function() child:Destroy() end)
                elseif child.Name == "PayomboyZ_ToastLayer" or child.Name:find("ToastLayer") then
                    _cachedToastLayer = child
                    _cachedToastStack = child:FindFirstChild("Stack")
                    if onlyToasts then
                        if _cachedToastStack then
                            for _, t in ipairs(_cachedToastStack:GetChildren()) do
                                if t:IsA("GuiObject") then pcall(function() t:Destroy() end) end
                            end
                        end
                    else
                        pcall(function() child:Destroy() end)
                        _cachedToastLayer = nil
                        _cachedToastStack = nil
                    end
                elseif not onlyToasts and (child.Name:find("PayomboyZ") or child.Name:find("ObsidianGlass")) and child:FindFirstChild("Stack") then
                    pcall(function() child:Destroy() end)
                end
            end
        end)
    end
end

