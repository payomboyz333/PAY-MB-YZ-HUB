local forgeCycleIndex = 1
local function executeForgeNow(forgeType, minOres)
    local items = getBackpackItems()
    local remote = getRemote("Forge", "ForgeRF")
    if not items or not remote or not remote:IsA("RemoteFunction") then
        return false, "Forge data or remote is unavailable"
    end

    forgeType = forgeType or State.ForgeType or "All"
    minOres = math.max(4, math.floor(tonumber(minOres or State.MinOreToForge) or 4))
    local totalOres, oreEntries = 0, {}
    for uuid, item in pairs(items) do
        if type(item) == "table" and item.Type == "Ore" then
            local count = math.max(1, math.floor(tonumber(item.Number) or 1))
            local power = 0
            if OreHelper and type(OreHelper.GetPower) == "function" then
                pcall(function() power = tonumber(OreHelper.GetPower(item.ID)) or 0 end)
            end
            totalOres += count
            oreEntries[#oreEntries + 1] = { UUID = uuid, Count = count, Power = power }
        end
    end
    if totalOres < 4 then return false, "Need at least 4 ores" end

    local rotating = forgeType == "All"
    local slot = forgeType
    local bareChest = not hasEquippedArmor()

    if bareChest then
        -- Bare-chest protection: Player MUST forge Armor first!
        -- If ores < 8, hold off on forging until 8 ores accumulate so ores aren't wasted on weapons!
        if totalOres < 8 then
            return false, "Holding ores for Armor forge (have " .. tostring(totalOres) .. "/8 ores)"
        end
        slot = "Armor"
    elseif rotating then
        local rotation = { "Weapon", "Armor", "Hat" }
        slot = rotation[((forgeCycleIndex - 1) % #rotation) + 1]
    end
    if slot ~= "Weapon" and slot ~= "Armor" and slot ~= "Hat" then slot = "Weapon" end

    local targetCount
    if slot == "Weapon" then
        targetCount = math.clamp(minOres, 4, 13)
    elseif slot == "Hat" then
        targetCount = (minOres >= 16 or totalOres >= 30) and 16 or 4
    elseif slot == "Armor" then
        if totalOres >= 23 and (minOres >= 20 or totalOres >= 50) then
            targetCount = 23
        elseif totalOres >= 11 and (minOres >= 11 or totalOres >= 25) then
            targetCount = 11
        elseif totalOres >= 8 then
            targetCount = 8
        elseif rotating and not bareChest then
            slot, targetCount = (totalOres >= 4 and "Weapon" or "Hat"), 4
        else
            return false, "Armor forging needs at least 8 ores (have " .. tostring(totalOres) .. ")"
        end
    end
    if totalOres < targetCount then return false, "Need " .. tostring(targetCount) .. " ores for " .. slot end

    if State.OreQualityMode == "High" then
        table.sort(oreEntries, function(a, b) return a.Power > b.Power end)
    elseif State.OreQualityMode == "Low" then
        table.sort(oreEntries, function(a, b) return a.Power < b.Power end)
    end
    local uuidList, selected = {}, 0
    for _, ore in ipairs(oreEntries) do
        local take = math.min(ore.Count, targetCount - selected)
        if take > 0 then uuidList[ore.UUID] = take; selected += take end
        if selected >= targetCount then break end
    end
    if selected < targetCount then return false, "Could not select enough ores" end

    local serverConfigType = slot == "Weapon" and "Weapon" or "Armor"
    local ok, result = pcall(function()
        return remote:InvokeServer({ ConfigType = serverConfigType, UUIDList = uuidList })
    end)
    if not ok or result == false then return false, "Forge request failed" end
    if rotating then
        forgeCycleIndex = slot == "Hat" and 1 or (forgeCycleIndex % 3) + 1
    end
    -- ★ FIX: แจ้งเตือน Forge สำเร็จทั้ง warn (console) และ notify (UI)
    if State and State.Debug then warn("[PAYOMBØYZ] Forge: " .. slot .. " (" .. selected .. ")") end
    pcall(function()
        notify(
            State.Language == "TH" and "หลอมสำเร็จ!" or "Forge Complete!",
            (State.Language == "TH"
                and ("หลอม " .. slot .. " สำเร็จ ใช้ " .. selected .. " แร่")
                or  ("Forged " .. slot .. " with " .. selected .. " ores")),
            "hammer"
        )
    end)
    -- ★ FIX: Auto-resync LeftInfoGUI post-forge to eliminate ore desync bug
    pcall(function()
        local remainingOres = 0
        local bp = getBackpackItems()
        if bp then
            for _, it in pairs(bp) do
                if type(it) == "table" and it.Type == "Ore" then
                    remainingOres = remainingOres + (tonumber(it.Number) or 1)
                end
            end
        end
        local LeftInfoGUI = require(ReplicatedStorage.GuiUtils.LeftInfoGUI)
        if LeftInfoGUI and LeftInfoGUI.UpdateOrePack then
            LeftInfoGUI.UpdateOrePack(remainingOres)
        end
    end)
    task.delay(0.25, function()
        if State.GodAutoEquipGoldRed then
            equipGoldAndRedGear()
        else
            equipBestGearNow(slot)
        end
    end)
    return true, slot, selected
end

local STONE_GRADE_RANKS = {
    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5,
    Mythic = 6,
    Eternal = 7,
    Secret = 8,
    Ancient = 9,
    Infinite = 10,
}

local function getStoneGrade(item)
    if type(item) ~= "table" then return 1 end
    local r = item.RarityLevel or item.Rarity or item.RareLevel or item.Rare
    if tonumber(r) then return tonumber(r) end
    if type(r) == "string" and STONE_GRADE_RANKS[r] then return STONE_GRADE_RANKS[r] end
    local id = tostring(item.ID or item.id or "")
    for name, rank in pairs(STONE_GRADE_RANKS) do
        if id:find(name) then return rank end
    end
    return 1
end

local function autoEnhanceEquippedGear()
    if Dynamic._isEnhanceBusy then return false, "busy" end
    Dynamic._isEnhanceBusy = true

    local success, result, detail = pcall(function()
        local bpd = nil
        pcall(function() bpd = require(ReplicatedStorage.LocalData.BackpackData) end)
        if not bpd then return false, "no_bpd" end

        local helper = nil
        pcall(function()
            if ReplicatedStorage:FindFirstChild("Config") and ReplicatedStorage.Config:FindFirstChild("Enhant") and ReplicatedStorage.Config.Enhant:FindFirstChild("Helper") then
                helper = require(ReplicatedStorage.Config.Enhant.Helper)
            end
        end)
        if not helper then return false, "no_helper" end

        local coins = 0
        pcall(function()
            local eco = LocalPlayer:FindFirstChild("Eco")
            if eco and eco:FindFirstChild("coin") then
                coins = tonumber(eco.coin.Value) or 0
            end
        end)

        local s1Count = 0
        local s2Count = 0
        local protCount = 0
        pcall(function()
            s1Count = bpd.GetNumberByIDType("EnhantStone_1", "Material") or 0
            s2Count = bpd.GetNumberByIDType("EnhantStone_2", "Material") or 0
            protCount = bpd.GetNumberByIDType("EnhantProtect", "Material") or 0
        end)

        local priorityMode = State.EnhancePriority or "WeaponFirst"
        local maxTargetLv = math.clamp(tonumber(State.EnhanceMaxLevel) or 20, 1, 20)
        local failLv = (helper.GetFailLevel and helper.GetFailLevel()) or 6

        local candidateSlots
        if priorityMode == "WeaponOnly" then
            candidateSlots = { "Weapon" }
        elseif priorityMode == "ArmorOnly" then
            candidateSlots = { "Armor" }
        elseif priorityMode == "HatOnly" then
            candidateSlots = { "Hat" }
        else
            -- Strict priority: Weapon first -> Armor -> Hat
            candidateSlots = { "Weapon", "Armor", "Hat" }
        end

        local gearList = {}
        for _, slot in ipairs(candidateSlots) do
            local uuid = nil
            pcall(function() uuid = bpd.GetEquipUUIDByIndex(slot) end)
            if not uuid and getEquippedSlotUUID then
                uuid = getEquippedSlotUUID(slot)
            end

            if uuid then
                local item = nil
                pcall(function() item = bpd.GetItemData(uuid) end)
                if item and type(item) == "table" then
                    local curLv = tonumber(item.Level) or 0
                    local isMax = false
                    if helper.IsMax then
                        isMax = helper.IsMax(curLv)
                    else
                        isMax = (curLv >= 20)
                    end

                    if curLv < maxTargetLv and not isMax then
                        table.insert(gearList, {
                            Slot = slot,
                            UUID = uuid,
                            Level = curLv,
                            NextLevel = curLv + 1,
                        })
                    end
                end
            end
        end

        if #gearList == 0 then return false, "all_maxed" end

        if priorityMode == "Balanced" then
            table.sort(gearList, function(a, b)
                if a.Level ~= b.Level then
                    return a.Level < b.Level
                end
                local slotOrder = { Weapon = 1, Armor = 2, Hat = 3 }
                return (slotOrder[a.Slot] or 99) < (slotOrder[b.Slot] or 99)
            end)
        end

        -- Try to enhance the best available candidate in priority order
        for _, gear in ipairs(gearList) do
            local nextLv = gear.NextLevel
            local needCoin = (helper.GetNeedCoin and helper.GetNeedCoin(nextLv)) or 0
            local needS1 = (helper.GetNeedEnhantStone_1 and helper.GetNeedEnhantStone_1(nextLv)) or 0
            local needS2 = (helper.GetNeedEnhantStone_2 and helper.GetNeedEnhantStone_2(nextLv)) or 0

            local canAfford = (coins >= needCoin) and (s1Count >= needS1) and (s2Count >= needS2)
            if canAfford then
                local useProt = false
                if gear.Level >= failLv then
                    if State.EnhanceUseProtect then
                        if protCount > 0 then
                            useProt = true
                        else
                            if State.EnhanceStopAtFail then
                                -- Safe Mode: Skip this item to protect gear level from dropping
                                continue
                            else
                                useProt = false
                            end
                        end
                    else
                        useProt = false
                    end
                end

                -- Call TryEnhantEquipment with table arg { UseProtect = bool }
                local ok, res = pcall(function()
                    if bpd.TryEnhantEquipment then
                        return bpd.TryEnhantEquipment(gear.UUID, { UseProtect = useProt })
                    else
                        local enhRF = getRemote("Backpack", "EnhantEquipmentRF")
                        if enhRF then
                            return enhRF:InvokeServer(gear.UUID, { UseProtect = useProt })
                        end
                    end
                end)

                if ok and res then
                    if State.Debug then
                        print(string.format("[PAYOMBØYZ AutoEnhance]: %s upgraded to +%d (Protect=%s)", gear.Slot, nextLv, tostring(useProt)))
                    end
                    return true, gear.Slot, nextLv
                end
                return false, "failed_roll"
            end
        end

        return false, "insufficient_materials"
    end)

    Dynamic._isEnhanceBusy = false
    return success and result, detail
end

local function autoEnchantEquippedGear()
    if Dynamic._isEnchantBusy then return false, 0 end
    Dynamic._isEnchantBusy = true

    local bp = getBackpackItems()
    if not bp then
        Dynamic._isEnchantBusy = false
        return false, 0
    end

    local bpd = nil
    pcall(function() bpd = require(ReplicatedStorage.LocalData.BackpackData) end)

    local targetSlots
    if State.EnchantSlots == "Weapon" then
        targetSlots = { "Weapon" }
    elseif State.EnchantSlots == "Armor" then
        targetSlots = { "Armor" }
    elseif State.EnchantSlots == "Hat" then
        targetSlots = { "Hat" }
    else
        -- Strict priority order: Weapon first, then Armor, then Hat
        targetSlots = { "Weapon", "Armor", "Hat" }
    end

    -- 1. Scan equipped gear in STRICT priority order
    local equippedTargets = {}
    local totalEmptySlots = 0

    for _, slot in ipairs(targetSlots) do
        local uuid = nil
        pcall(function()
            if bpd and bpd.GetEquipUUIDByIndex then
                uuid = bpd.GetEquipUUIDByIndex(slot)
            end
        end)
        if not uuid and getEquippedSlotUUID then
            uuid = getEquippedSlotUUID(slot)
        end

        if uuid then
            local item = bp[uuid]
            if not item and bpd and bpd.GetItemData then
                pcall(function() item = bpd.GetItemData(uuid) end)
            end

            if item and type(item) == "table" then
                local maxSlots = tonumber(item.EnchanceNum or item.EnhanceNum) or 0
                if maxSlots > 0 then
                    local currentList = item.EnchanceList or item.EnhanceList or {}
                    local usedSlots = 0
                    for _, s in ipairs(currentList) do
                        if s and (s.ID or s.id or s.Name) and (s.ID ~= "" and s.id ~= "") then
                            usedSlots = usedSlots + 1
                        end
                    end
                    local empty = maxSlots - usedSlots
                    if empty > 0 then
                        table.insert(equippedTargets, { Slot = slot, UUID = uuid, Item = item, Empty = empty })
                        totalEmptySlots = totalEmptySlots + empty
                    end
                end
            end
        end
    end

    if totalEmptySlots == 0 or #equippedTargets == 0 then
        Dynamic._isEnchantBusy = false
        return false, 0
    end

    -- 2. Gather stones bounded strictly by totalEmptySlots (O(1) memory footprint)
    local maxAllowedRank = STONE_GRADE_RANKS[State.EnchantMaxGrade] or 6
    if State.EnchantMaxGrade == "All" then maxAllowedRank = 99 end

    local stoneStacks = {}
    for uuid, item in pairs(bp) do
        if type(item) == "table" then
            local isStone = item.Type == "EnchStone" or (item.ID and tostring(item.ID):find("Stone"))
            if isStone then
                local gradeRank = getStoneGrade(item)
                local skip = false
                if State.EnchantKeepHighGrade and gradeRank >= 7 then
                    skip = true -- keep Eternal, Secret, Ancient
                end
                if gradeRank > maxAllowedRank then
                    skip = true
                end
                if not skip then
                    local count = tonumber(item.Number or item.Count) or 1
                    table.insert(stoneStacks, { UUID = uuid, Rank = gradeRank, Count = count })
                end
            end
        end
    end

    if #stoneStacks == 0 then
        Dynamic._isEnchantBusy = false
        return false, 0
    end
    table.sort(stoneStacks, function(a, b) return a.Rank < b.Rank end)

    local usableStones = {}
    for _, stack in ipairs(stoneStacks) do
        local take = math.min(stack.Count, totalEmptySlots - #usableStones)
        for _ = 1, take do
            table.insert(usableStones, { UUID = stack.UUID, Rank = stack.Rank })
        end
        if #usableStones >= totalEmptySlots then break end
    end

    if #usableStones == 0 then
        Dynamic._isEnchantBusy = false
        return false, 0
    end

    -- 3. Inscribe stones safely into equipped gear in strict priority order
    local enchantRE = getRemote("Backpack", "EnchantRE")
    local stoneIdx = 1
    local totalEnchanted = 0

    for _, target in ipairs(equippedTargets) do
        local emptySlots = target.Empty
        while emptySlots > 0 and stoneIdx <= #usableStones do
            local stone = usableStones[stoneIdx]
            stoneIdx = stoneIdx + 1
            local fired = false
            pcall(function()
                if bpd and bpd.EnchantEquipment then
                    bpd.EnchantEquipment(target.UUID, stone.UUID)
                    fired = true
                elseif enchantRE then
                    enchantRE:FireServer(target.UUID, stone.UUID)
                    fired = true
                end
            end)
            if fired then
                totalEnchanted = totalEnchanted + 1
                emptySlots = emptySlots - 1
                task.wait(0.12)
            end
        end
        if stoneIdx > #usableStones then break end
    end

    Dynamic._isEnchantBusy = false
    return totalEnchanted > 0, totalEnchanted
end

