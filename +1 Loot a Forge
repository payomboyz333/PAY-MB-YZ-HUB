local _lastMagnetTick = 0
local function runDropMagnet()
    local now = os.clock()
    if now - _lastMagnetTick < 0.4 then return end
    _lastMagnetTick = now

    local oreCache = workspace:FindFirstChild("OreCache")
    if not oreCache then return end

    local targetCF
    if State.MagnetTarget == "Safe Zone" then
        targetCF = getSafeZoneCF() + Vector3.new(0, 2, 0)
    else
        local r = hrp()
        if not r then return end
        -- Offset 4 studs above player to prevent physics collision and character fling
        targetCF = r.CFrame * CFrame.new(0, 4.0, 0)
    end

    local children = oreCache:GetChildren()
    for _, drop in ipairs(children) do
        if drop:IsA("Model") then
            pcall(function()
                -- Disable collisions and zero velocities on ALL descendants to eliminate physics thrashing
                for _, part in ipairs(drop:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end
                end
                if drop.PrimaryPart then
                    if (drop.PrimaryPart.Position - targetCF.Position).Magnitude > 4 then
                        drop:PivotTo(targetCF)
                    end
                else
                    drop:PivotTo(targetCF)
                end
            end)
        end
    end
end

-- Time-Bounded Sliding Window Caches (O(1) memory footprint over 24/7 sessions)
local _firedPromptTimes = {}
local _notifiedDropTimes = {}
local _lastPromptTick = 0
local _lastCachePruneTick = 0

local function runUltraPrompts()
    if not fireproximityprompt then return end
    local now = os.clock()
    if now - _lastPromptTick < 0.45 then return end
    _lastPromptTick = now

    -- Periodic sliding-window prune: purge stale prompt and notification keys
    if now - _lastCachePruneTick >= 3.0 then
        _lastCachePruneTick = now
        for prompt, fireTime in pairs(_firedPromptTimes) do
            if (now - fireTime) >= 4.0 then
                _firedPromptTimes[prompt] = nil
            end
        end
        for drop, notifTime in pairs(_notifiedDropTimes) do
            if (now - notifTime) >= 60.0 then
                _notifiedDropTimes[drop] = nil
            end
        end
    end

    local oreCache = workspace:FindFirstChild("OreCache")
    if not oreCache then return end

    local prompts = {}
    for _, p in ipairs(oreCache:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local lastFired = _firedPromptTimes[p]
            if not lastFired or (now - lastFired >= 1.2) then
                table.insert(prompts, p)
                if #prompts >= 20 then break end -- Capped batch to prevent executor hook queue overflow
            end
        end
    end

    -- Check for rare drops to dispatch Webhook alert
    if State.NotifyRareDrops and State.WebhookEnabled then
        for _, drop in ipairs(oreCache:GetChildren()) do
            if drop:IsA("Model") and not _notifiedDropTimes[drop] then
                local name = drop.Name
                local highlight = drop:FindFirstChildOfClass("Highlight")
                if highlight and (name:find("Mythic") or name:find("Eternal") or name:find("Secret") or name:find("Ancient") or name:find("Infinite")) then
                    _notifiedDropTimes[drop] = now
                    local isTH = State.Language == "TH"
                    sendWebhook(
                        isTH and "ตรวจพบไอเทมหายากระดับสูง!" or "Rare Item Acquired",
                        isTH and "ระบบดูดของปลอดภัยจัดเก็บไอเทมเข้ากระเป๋าเรียบร้อยแล้ว" or "A rare drop was generated and secured by Safe Magnet.",
                        {
                            { name = isTH and "ชื่อไอเทม" or "Drop Item", value = name, inline = true },
                            { name = isTH and "กิจกรรมปัจจุบัน" or "Location", value = tostring(Stats.CurrentActivity), inline = true },
                        },
                        0xF59E0B
                    )
                end
            end
        end
    end

    -- Fire prompts with timestamp tracking
    for _, p in ipairs(prompts) do
        _firedPromptTimes[p] = now
        pcall(function()
            p.MaxActivationDistance = 1e6
            p.RequiresLineOfSight = false
            p.HoldDuration = 0
            fireproximityprompt(p, 0)
            Stats.OresCollected = Stats.OresCollected + 1
        end)
    end
end

local lastSafeEvacuationAt = 0
local function checkSafeEvacuate()
    local cur, maxNum = getPackInfo()
    local packFullPercent = (cur / math.max(maxNum, 1)) * 100

    local h = hum()
    local hpPercent = h and ((h.Health / math.max(h.MaxHealth, 1)) * 100) or 100

    -- 1. Full Pack Management: Claim ore from ground → Forge in-place → Sell
    -- ★ Step 5 FIX: ต้อง ClaimedAllOreRE ก่อน sell ทุกกรณี ไม่ใช่แค่ตอน evac
    if packFullPercent >= (State.EvacuateThreshold or 90) then
        pcall(function()
            call("Stage", "ClaimedAllOreRE")   -- ดูดแร่บน ground เข้ากระเป๋าก่อน
            task.wait(0.1)
            executeForgeNow(State.ForgeType or "All", 4)
            if not (State and State.GodSafeForgeFix) then
                runSelectiveSellBatch()
                call("Backpack", "TrySellAllRE")
            end
            call("Upgrade", "UpgradeOnceRE", "OrePack")
        end)
    end

    -- 2. Low HP Emergency Escape (Only triggers when character is actually dying)
    if State.LowHPEvacuate and hpPercent <= (State.LowHPThreshold or 25) then
        local now = os.clock()
        if now - lastSafeEvacuationAt < 10 then return true end
        lastSafeEvacuationAt = now

        Stats.CurrentActivity = TF("StatusSafeEvacuate", ("Critical HP (%.1f%%)"):format(hpPercent))
        call("Stage", "ClaimedAllOreRE")
        tpTo(getSafeZoneCF())
        task.wait(0.15)
        call("Backpack", "TrySellAllRE")
        return true
    end

    return false
end

