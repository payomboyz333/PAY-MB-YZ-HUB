local function runStageBlitz(force)
    local now = os.clock()
    if _isBlitzingStages then
        if now - _blitzStartTime > 120 then
            _isBlitzingStages = false
        else
            return
        end
    end

    if not force then
        local cooldown = (State.GodModeStageBlitz50 or State.GodFarmStageBlitz) and 0.5 or 3.0
        if now - _lastBlitzFinishedTime < cooldown then return end
    end
    if checkSafeEvacuate() then return end

    local stageFinishedRF = getRemote("Stage", "StageFinishedRF")
    local claimedAllOreRE = getRemote("Stage", "ClaimedAllOreRE")
    local getOreRF        = getRemote("Stage", "GetOreRF")
    local getEnhantStoneRE = getRemote("Stage", "GetEnhantStoneRE")
