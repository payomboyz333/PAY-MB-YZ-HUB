local Runtime = {
    Running = true,
    Connections = {},
    Threads = {},
    Guis = {},
}

function Runtime:AddConnection(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then
        table.insert(self.Connections, conn)
    end
    return conn
end

function Runtime:SpawnLoop(delaySec, fn)
    local thread = task.spawn(function()
        while self.Running and _G.PayomboyZActiveToken == myToken do
            local ok, err = pcall(fn)
            if not self.Running or _G.PayomboyZActiveToken ~= myToken then break end
            local waitTime = (type(delaySec) == "function" and delaySec())
                or (type(delaySec) == "number" and delaySec)
                or 0.1
            task.wait(math.max(waitTime or 0.1, 0.05))
        end
    end)
    table.insert(self.Threads, thread)
    return thread
end

function Runtime:Cleanup()
    self.Running = false

    -- 1. Disconnect all RBXScriptConnections
    for _, conn in ipairs(self.Connections) do
        pcall(function()
            if conn and conn.Connected then conn:Disconnect() end
        end)
    end
    table.clear(self.Connections)

    -- 2. Cancel running coroutines / worker threads
    for _, th in ipairs(self.Threads) do
        pcall(function()
            if th and coroutine.status(th) ~= "dead" then
                task.cancel(th)
            end
        end)
    end
    table.clear(self.Threads)

    -- 3. Destroy previous UI Window and purge leftover ScreenGuis & Toasts
    if CurrentWindow and type(CurrentWindow.Destroy) == "function" then
        pcall(function() CurrentWindow:Destroy() end)
    end
    pcall(function()
        purgeAllToastLayers(false)
        local parents = {}
        if typeof(gethui) == "function" then
            local h = gethui()
            if h then table.insert(parents, h) end
        end
        local cg = (typeof(cloneref) == "function" and cloneref(game:GetService("CoreGui"))) or game:GetService("CoreGui")
        if cg then table.insert(parents, cg) end
        local pGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pGui then table.insert(parents, pGui) end
        for _, parent in ipairs(parents) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child.Name:find("PayomboyZ") or child.Name:find("ObsidianGlass") or child.Name:find("Toast") then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        end
    end)
end

