local function engageIdleTraining()
    if _isHuntingBoss then return end
    local r = hrp()

    -- Target Pad Selection:
    local targetZone = nil
    if State.ForceVIPTrain or State.AutoTrainX100 or State.TrainArea == "9" then
        for _, z in ipairs(TrainAreaConfig) do
            if z.Id == 9 then targetZone = z break end
        end
    end
    if not targetZone then
        local safePad = getBestLegitTrainZone() or TrainAreaConfig[1]
        targetZone = (State.AutoTrainBestZone and safePad) or getBestTrainZone(State.ForceVIPTrain) or safePad
    end
    local targetId = (targetZone and targetZone.Id) or 1

    -- In combat / dungeon / tower: DO NOT physically teleport to pad (avoids disrupting combat),
    -- but STILL maintain AutoTrainAreaID = targetId and train remotely with x100 multiplier!
    if r and not (isInFight() or isInDungeon()) then
        local targetCF = nil
        if targetZone and targetZone.PadPos and targetZone.DummyPos then
            -- ★ 2K.txt CFrame: Stand on treadmill pad facing dummy directly
            targetCF = CFrame.lookAt(targetZone.PadPos + Vector3.new(0, 1.0, 0), targetZone.DummyPos)
        elseif targetZone then
            local part = getTrainZonePart(targetZone.Id)
            targetCF = (part and (part.CFrame + Vector3.new(0, 3.2, 0)))
                or CFrame.new((targetZone.FallbackPos or targetZone.PadPos) + Vector3.new(0, 3.2, 0))
        end

        if targetCF then
            local dist = (Vector3.new(r.Position.X, targetCF.Position.Y, r.Position.Z) - targetCF.Position).Magnitude
            local now = os.clock()
            if dist > 4.0 or _currentTrainZoneId ~= targetId then
                _currentTrainZoneId = targetId
                _lastTrainTeleportTick = now
                pcall(function()
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                    r.CFrame = targetCF
                end)
                task.wait(0.06)
                local part = targetZone and getTrainZonePart(targetZone.Id)
                if part and typeof(firetouchinterest) == "function" then
                    pcall(function()
                        firetouchinterest(r, part, 0)
                        task.wait(0.02)
                        firetouchinterest(r, part, 1)
                    end)
                end
            end
        end
    end

    -- Broadcast target ID + fire remote (only fire remote if attribute has changed!)
    State.TrainArea = tostring(targetId)
    if LocalPlayer:GetAttribute("AutoTrainAreaID") ~= targetId then
        LocalPlayer:SetAttribute("AutoTrainAreaID", targetId)
        call("Train", "IntoAutoTrainRE", targetId)
    end

    -- Continuous TrainOnce trigger with pre-hit packet injection
    pcall(function()
        local tc = TrainCTRL or (ReplicatedStorage:FindFirstChild("CTRL") and require(ReplicatedStorage.CTRL.TrainCTRL))
        if tc then
            if tc.StartTrain and not (tc.GetIsTraining and tc.GetIsTraining()) then
                tc.StartTrain()
            end
            if tc.StartAutoTrain and not (tc.GetIsAutoing and tc.GetIsAutoing()) then
                tc.StartAutoTrain()
            end
            if State.ForceVIPTrain and LocalPlayer:GetAttribute("AutoTrainAreaID") ~= 9 then
                LocalPlayer:SetAttribute("AutoTrainAreaID", 9)
                call("Train", "IntoAutoTrainRE", 9)
            end
            if tc.TrainOnce then tc.TrainOnce() end
        else
            if State.ForceVIPTrain and LocalPlayer:GetAttribute("AutoTrainAreaID") ~= 9 then
                LocalPlayer:SetAttribute("AutoTrainAreaID", 9)
                call("Train", "IntoAutoTrainRE", 9)
            end
            call("Train", "TrainOnceRE")
        end
    end)
    Stats.CurrentActivity = TF("StatusTrain", (targetId == 9 and "9 (x100 VIP)" or (safePad and safePad.Name) or tostring(targetId)))
end

