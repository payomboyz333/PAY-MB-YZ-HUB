-- ★ INSTANT KILL — single enemy (multi-layer: BindableEvent + EnemyCTRL + HPCTRL + Humanoid)
local function instantKillEnemy(enemy)
    if not enemy or not enemy:IsA("Model") then return end
    local uuidAttr    = enemy:GetAttribute("UUID")
    local enemyIdAttr = enemy:GetAttribute("EnemyID")
    local enemyName   = enemy.Name
    local primaryId   = enemyIdAttr or uuidAttr or enemyName

    -- Dungeon Anti-Freeze: Ensure DeadCF is set so RewardUtils.CreateOres never errors
    pcall(function()
        local _, u140 = getDungeonManagerEnv()
        if u140 then
            local pivot = enemy:GetPivot()
            local r = hrp()
            u140.DeadCF = pivot or (r and r.CFrame) or CFrame.new(3482, 23, -4)
        end
    end)

    pcall(function()
        -- Layer 1: Native BindableEvent (Instant local hit registration)
        local hitBE = Bindable_EnemyHit or getBindable("Attack", "EnemyHitBE")
        if hitBE then
            hitBE:Fire(primaryId, 1e30, { SkillID = "K_Skill_1_ATK" })
            if primaryId ~= enemyName then
                hitBE:Fire(enemyName, 1e30, { SkillID = "K_Skill_1_ATK" })
            end
        end

        -- Layer 2: EnemyCTRL client state sync (Zero-latency death event from old script)
        if EnemyCTRL then
            if EnemyCTRL.HurtEnemy then pcall(function() EnemyCTRL.HurtEnemy(primaryId, 1e30) end) end
            if EnemyCTRL.DeadEnemyData then pcall(function() EnemyCTRL.DeadEnemyData(primaryId, { NotDeadVFX = true }) end) end
            if primaryId ~= enemyName and EnemyCTRL.DeadEnemyData then
                pcall(function() EnemyCTRL.DeadEnemyData(enemyName, { NotDeadVFX = true }) end)
            end
        end

        -- Layer 3: HP bar zero synchronization & humanoid death
        if HPCTRL and HPCTRL.SetCurrentHP then
            pcall(function() HPCTRL.SetCurrentHP(enemy, 0) end)
        end
        enemy:SetAttribute("Dead", true)
        local h = enemy:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end

        -- Layer 4: Server Remotes (Force kill on server side)
        local attackBotRE = getRemote("Attack", "AttackBotRE")
        if attackBotRE then pcall(function() attackBotRE:FireServer(enemy, 1e30) end) end

        local killEnemyRE = getRemote("Attack", "KillEnemyRE")
        if killEnemyRE then pcall(function() killEnemyRE:FireServer(primaryId) end) end

        local atkServiceRE = getRemote("Attack", "AttackEnemyServiceRE")
        if atkServiceRE then pcall(function() atkServiceRE:FireServer(primaryId, 1e30) end) end

        -- Layer 5: StageUtils HurtEnemy if inside Stage fight
        pcall(function()
            if LocalPlayer:GetAttribute("IntoFight") then
                local stageUtils = require(LocalPlayer.PlayerScripts.Manager.StageManager.StageUtils)
                local curStageId = LocalPlayer:GetAttribute("StageID") or "Stage_1"
                if stageUtils and stageUtils.HurtEnemy then
                    stageUtils.HurtEnemy(curStageId, primaryId, 1e30)
                end
            end
        end)

        Stats.Kills = Stats.Kills + 1
    end)
end

