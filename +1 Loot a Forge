local function getRemote(folder, name)
    if not RemoteRoot then return nil end
    if not name then
        return RemoteRoot:FindFirstChild(folder)
    end
    local f = RemoteRoot:FindFirstChild(folder)
    return f and f:FindFirstChild(name) or RemoteRoot:FindFirstChild(name)
end

local function call(folder, name, ...)
    local r = getRemote(folder, name)
    if not r then
        if State.Debug then warn("[PAYOMBØYZ] Remote missing:", folder, name) end
        return nil
    end
    local args = { ... }
    local ok, res = pcall(function()
        if r:IsA("RemoteFunction") then
            return r:InvokeServer(unpack(args))
        else
            r:FireServer(unpack(args))
        end
    end)
    return ok and res or nil
end

