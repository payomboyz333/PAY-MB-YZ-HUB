        local ok2, src2 = pcall(function() return game:HttpGet(UI_BACKUP_URL, true) end)
        if ok2 and type(src2) == "string" and (src2:find("ObsidianGlassEngine") or src2:find("PAYOMBØYZ UI LIBRARY")) then
            source = src2
        end
    end

    if not source or source == "" then
        error("Could not download valid PAYOMBØYZ UI Library from GitHub. Both main and backup links failed.", 0)
    end

    local chunk, compileError = loadstring(source)
    if type(chunk) ~= "function" then
        error("PayomboyZ UI compile failed: " .. tostring(compileError), 0)
    end
    local initOk, library = pcall(chunk)
    if not initOk or type(library) ~= "table" or type(library.CreateWindow) ~= "function" then
        error("PayomboyZ UI initialization failed: " .. tostring(library), 0)
    end
    CurrentLibrary = library

    -- Monkey-patch Notify: respect State.ShowNotifications, enforce max 1 toast, mobile touch fixes, hard destroy fallback
    pcall(function()
        local origNotify = library.Notify
        library.Notify = function(self, cfg)
            if not (State and State.ShowNotifications) then
                return nil
            end
            if type(cfg) == "string" then cfg = { Content = cfg } end
            cfg = type(cfg) == "table" and cfg or {}
            cfg.Duration = math.min(tonumber(cfg.Duration) or 2.5, 3)

            -- Keep at most 1 toast on screen at any time: purge old ones first
            pcall(function() purgeAllToastLayers(true) end)

            local res = origNotify(self, cfg)
            if res and res.Instance then
                local toast = res.Instance

                -- Guaranteed fallback: force destroy after duration + 0.3s
                task.delay(cfg.Duration + 0.3, function()
                    pcall(function()
                        if toast and toast.Parent then toast:Destroy() end
                    end)
                end)

                -- Mobile touch fixes for close button & toast body
                pcall(function()
                    local function forceKill()
                        pcall(function()
                            if res.Dismiss then res:Dismiss() end
                            if toast then toast:Destroy() end
                        end)
                    end

                    for _, child in ipairs(toast:GetDescendants()) do
                        if child:IsA("TextButton") and (child.Text == "×" or child.Text == "X") then
                            child.Active = true
                            child.Size = UDim2.fromOffset(36, 36)
                            child.Position = UDim2.new(1, -40, 0, 4)
                            child.ZIndex = 1000
                            child.MouseButton1Click:Connect(forceKill)
                            if child.TouchTap then child.TouchTap:Connect(forceKill) end
                            child.InputBegan:Connect(function(inp)
                                if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                                    forceKill()
                                end
                            end)
                        end
                    end

                    toast.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.Touch then
                            forceKill()
                        end
                    end)
                end)
            end
            return res
        end
    end)

    return library
end

